{
  "exe": "/app/build/maya-ik2",
  "args": [
    "--model",
    "/models/inkling-2-mini/Inkling-2-Mini-UD-Q4_K_XL.gguf",
    "--max-context",
    "196608",
    "--draft",
    "/models/inkling-2-mini/mtp.safetensors"
  ],
  "env": {
    "IK2_KV": "fp8",
    "IK2_GATE_TILE": "64",
    "IK2_GATE_BF16": "1",
    "IK2_Q8_UNROLL": "1",
    "IK2_BATCH_PREFILL": "1",
    "IK2_DRAFT_CTX": "65536"
  },
  "tokenizer": "/models/inkling-2-mini/tokenizer",
  "model_name": "inkling-2-mini",
  "vision": {
    "exe": "/app/build-vision/bin/maya-vision",
    "mmproj": "/models/inkling-2-mini/mmproj-BF16.gguf",
    "model": "/models/inkling-2-mini/Inkling-2-Mini-UD-Q4_K_XL.gguf",
    "gpu": true,
    "resident": true
  }
}
