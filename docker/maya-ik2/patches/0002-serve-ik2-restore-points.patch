+IK2_RESTORE_LEAST = 256     # maya-ik2 saves a Snap in ~4 ms, so even compact system prompts benefit across sessions
+
+
+def inkling_restore_points(ids, user_id, system_id=None, tail=512, least=IK2_RESTORE_LEAST) -> dict:
+    """Where maya-ik2 keeps restore points for this Inkling 2 prompt -> {"marks": [pos, ...], "tail": pos, "shared": pos}.
+    - "shared": the boundary after tools + system prompt (right before the template's `Thinking effort level:` system
+      message when one sits before the first `<|message_user|>`, else at the first `<|message_user|>`), so sessions
+      sharing the same system prompt and tools reuse it even across reasoning_effort changes;
+    - marks: the first `<|message_user|>` (when distinct from `shared`, giving 0-token reuse for same-effort sessions)
+      and the last `<|message_user|>` / post-user `<|message_system|>` turn boundary (for edits/retries);
+    - "tail": `tail` tokens before the end when the last turn is long."""
+    if user_id is None or len(ids) < 2:
+        return {}
+    first = None
+    try:
+        first = ids.index(user_id)
+    except ValueError:
+        pass
+    effort_pos = None
+    if first is not None and system_id is not None:
+        for i in range(first - 1, -1, -1):
+            if ids[i] == system_id:
+                effort_pos = i
+                break
+    last = None
+    if first is not None:
+        for i in range(len(ids) - 1, first - 1, -1):
+            t = ids[i]
+            if t == user_id or t == system_id:
+                last = i
+                break
+    shared = None
+    if effort_pos is not None and effort_pos >= least:
+        shared = effort_pos
+    elif first is not None and first >= least:
+        shared = first
+    marks, out = [], {}
+    if shared is not None:
+        out["shared"] = shared
+    if first is not None and first >= least and first != shared:
+        marks.append(first)
+    if last is not None and last >= least and last != first and last != shared:
+        marks.append(last)
+    t = len(ids) - tail
+    if tail > 0 and t >= least and (last is None or t > last) and (shared is None or t > shared):
+        out["tail"] = t
+    if marks:
+        out["marks"] = sorted(marks)
+    return out
+
+
