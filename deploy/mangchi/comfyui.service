# ComfyUI on Mangchi (Jetson Thor). Backs the MiniMax-H3-Image chat model
# (src/grimoire/image_server.py). LAN/tailnet only: it has no auth.
#
#   sudo cp deploy/mangchi/comfyui.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now comfyui
[Unit]
Description=ComfyUI
After=network-online.target
Wants=network-online.target

[Service]
User=yeowool
WorkingDirectory=/home/yeowool/comfyui
ExecStart=/home/yeowool/comfyui/.venv/bin/python main.py --listen 0.0.0.0 --port 8188 --disable-auto-launch --preview-method none --disable-pinned-memory
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
