+template <int NT>
+__device__ __forceinline__ void widen(bf16 (*dst)[LD], const Pieces<NT>& p) {
+#pragma unroll
+    for (int r = 0; r < 256 / NT; ++r) {
+        const int i = threadIdx.x + r * NT, key = i >> 2, q = i & 3;
+        const unsigned w[4] = {p.w[r].x, p.w[r].y, p.w[r].z, p.w[r].w};
+        const uint32_t s[2] = {tf_common::fp8pair((p.s[r] & 0xFFu) * 0x101u), tf_common::fp8pair((p.s[r] >> 8) * 0x101u)};
