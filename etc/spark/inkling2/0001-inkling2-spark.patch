new file mode 100644
index 00000000..4f3c91c9
--- /dev/null
+++ b/zig/src/families/inkling2/turns.zig
@@ -0,0 +1,102 @@
+//! Turn reuse: a prompt's state kept at a few of its positions, so a later prompt that starts with the same tokens
+//! resumes there instead of reading them again. The global layers' caches are not copied: every kept turn reads the
+//! one live set, so a turn stays good only while no pass since has started before its position. What a resumed pass
+//! cannot rebuild from them is copied (Forward.turn): each local ring's last `window` rows, every convolution history,
+//! and the drafter's local rings.
+const std = @import("std");
+const cfg = @import("config.zig");
+const dc = @import("draft_config.zig");
+
+/// Slot 0 keeps the end of the last prompt; 1 to 3 the server's shared-prefix cuts (Request.shared_prefixes), latest first.
+pub const slots = 4;
+/// The ring rows a pass resumed at `at` reads back: positions [at - window, at).
+pub const window = cfg.local_window;
+
+/// A kept turn: its position (0: none) and its tokens' hash.
+pub const Kept = struct { at: usize = 0, hash: u64 = 0 };
+
+pub fn hash(tokens: []const u32) u64 {
+    return std.hash.Wyhash.hash(0, std.mem.sliceAsBytes(tokens));
+}
+
+/// The kept turn a prompt resumes from: the furthest whose tokens start it, short of its last token (null: none).
+pub fn find(kept: []const Kept, prompt: []const u32) ?usize {
+    var best: ?usize = null;
+    for (kept, 0..) |k, i| {
+        if (k.at == 0 or k.at >= prompt.len) continue;
+        if (best) |b| if (k.at <= kept[b].at) continue;
+        if (hash(prompt[0..k.at]) == k.hash) best = i;
+    }
+    return best;
+}
+
+/// A pass resumed at `at` overwrites the global caches from there: every turn kept past it is gone.
+pub fn drop(kept: []Kept, at: usize) void {
+    for (kept) |*k| if (k.at > at) {
+        k.* = .{};
+    };
+}
+
+/// The positions a pass from `at` keeps, by slot (0: none): the prompt's end, then the server's cuts (ascending).
+pub fn marks(len: usize, cuts: []const u32, at: usize) [slots]usize {
+    var out: [slots]usize = @splat(0);
+    out[0] = len;
+    for (cuts, 0..) |c, j| {
+        const slot = cuts.len - j;
+        if (slot < slots and c > at and c < len) out[slot] = c;
+    }
+    return out;
+}
+
+pub fn convBytes(share: cfg.Share, j: usize) usize {
+    return 3 * (if (j < 2) share.keyHeads() * 128 else cfg.hidden) * 2;
+}
+
+/// One kept turn's copy of the target's state.
+pub fn targetBytes(share: cfg.Share) usize {
+    var n: usize = 0;
+    for (0..cfg.layers) |i| {
+        if (cfg.local(i)) n += 2 * window * share.keyHeads() * 128 * 2;
+        for (0..4) |j| n += convBytes(share, j);
+    }
+    return n;
+}
+
+/// One kept turn's copy of the drafter's local rings.
+pub fn draftBytes(share: cfg.Share) usize {
+    var n: usize = 0;
+    for (0..dc.layers) |i| if (dc.local(i)) {
+        n += 2 * window * share.keyHeads() * 128 * 2;
+    };
+    return n;
+}
+
+test "a prompt resumes from the furthest kept turn that starts it, and a pass drops what it overwrites" {
+    const a = [_]u32{ 1, 2, 3, 4, 5, 6, 7, 8 };
+    var kept: [slots]Kept = @splat(.{});
+    kept[1] = .{ .at = 3, .hash = hash(a[0..3]) };
+    kept[0] = .{ .at = 6, .hash = hash(a[0..6]) };
+    try std.testing.expectEqual(@as(?usize, 0), find(&kept, &a));
+    // another conversation shares only the first cut
+    const b = [_]u32{ 1, 2, 3, 9, 9, 9, 9 };
+    try std.testing.expectEqual(@as(?usize, 1), find(&kept, &b));
+    // the whole prompt kept: its last token still needs a pass for the first draw
+    try std.testing.expectEqual(@as(?usize, 1), find(&kept, a[0..6]));
+    drop(&kept, 3);
+    try std.testing.expect(kept[0].at == 0 and kept[1].at == 3);
+    drop(&kept, 0);
+    try std.testing.expectEqual(@as(?usize, null), find(&kept, &a));
+}
+
+test "a pass keeps its end in slot 0 and the server's cuts past its start, the latest first" {
+    try std.testing.expectEqual([slots]usize{ 9000, 7000, 6488, 4952 }, marks(9000, &.{ 4952, 6488, 7000 }, 0));
+    try std.testing.expectEqual([slots]usize{ 9000, 7000, 0, 0 }, marks(9000, &.{ 4952, 6488, 7000 }, 6488));
+    try std.testing.expectEqual([slots]usize{ 9000, 7000, 6488, 0 }, marks(9000, &.{ 6488, 7000 }, 0));
+    try std.testing.expectEqual([slots]usize{ 40, 0, 0, 0 }, marks(40, &.{}, 0));
+}
+
+test "a kept turn holds the local rings' window and every history" {
+    const share = try cfg.Share.init(0, 2);
+    try std.testing.expectEqual(@as(usize, 40 * 2 * 1024 * 1024 + 48 * (2 * 3072 + 2 * 27648)), targetBytes(share));
+    try std.testing.expectEqual(@as(usize, 4 * 2 * 1024 * 1024), draftBytes(share));
+}
