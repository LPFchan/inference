From d46edd8ddb87b9b2d18be972ea779e5b0052efe3 Mon Sep 17 00:00:00 2001
From: LPFchan <me@lost.plus>
Date: Wed, 25 Nov 2026 01:56:38 +0900
Subject: [PATCH 46/47] inkling2: keep turn at len-1 for exact-length resends
 and adopt idle pool regions in place

turns.marks saves slot 0 at len - 1 (when len > 1 and len - 1 > at) so exact-length retries and regenerates resume 1 token short of the prompt end instead of falling back to the system-prompt cut.

pool.Map.place evicts blocking idle neighbors or slides an idle source down in a separate move before growing in place when copying alongside the source would exceed pool memory.
---
 zig/src/families/inkling2/pool.zig  | 111 ++++++++++++++++++++++++++++
 zig/src/families/inkling2/turns.zig |  22 ++++--
 2 files changed, 125 insertions(+), 8 deletions(-)

diff --git a/zig/src/families/inkling2/pool.zig b/zig/src/families/inkling2/pool.zig
index 74436327..77168d96 100644
--- a/zig/src/families/inkling2/pool.zig
+++ b/zig/src/families/inkling2/pool.zig
@@ -113,6 +113,76 @@ pub const Map = struct {
                 m.held[i].used = m.clock;
                 return .{ .id = f.id, .adopted = true };
             }
+            if (!m.fits(capacity, source)) {
+                // Copying alongside `source` would exceed pool memory; adopt `source` in place by evicting
+                // blocking idle regions (and sliding down first in a separate move if needed).
+                var next_active_start: usize = m.tokens;
+                for (m.held[i + 1 .. m.n]) |h| if (h.lane != none) {
+                    next_active_start = h.region.start;
+                    break;
+                };
+                if (r.start + capacity <= next_active_start) {
+                    var dropped: u32 = 0;
+                    const j = i + 1;
+                    while (j < m.n and m.held[j].region.start < r.start + capacity) {
+                        std.debug.assert(m.held[j].lane == none);
+                        dropped |= m.held[j].refs;
+                        m.remove(j);
+                    }
+                    const grown: Region = .{ .start = r.start, .capacity = capacity };
+                    out.add(.{ .src = r, .dst = grown, .count = f.at, .lane = lane });
+                    m.held[i].region = grown;
