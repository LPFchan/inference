diff --git a/zig/kernels/cuda/inkling2_exl3.cuh b/zig/kernels/cuda/inkling2_exl3.cuh
index 2cd50aa2..72624f24 100644
--- a/zig/kernels/cuda/inkling2_exl3.cuh
+++ b/zig/kernels/cuda/inkling2_exl3.cuh
@@ -31,3 +31,145 @@ extern "C" __global__ void tf_ik_unrotate(const float* z, const int* picks, cons
     for (int j = 0; j < 4; ++j) out[(size_t)pair * width + c + j] =
         b((v[j] * tf_exl3::HAD_SCALE) * __half2float(svh[(size_t)expert * width + c + j]));
 }
+
+
+// Prompt rows of the routed EXL3 dot, after the common prompt path (exl3_prompt.cuh) at any trellis width: a block
+// takes 256 columns of one expert for up to 64 members over the whole K, weights and rows staged through shared
+// memory; each decoded weight tile is the A operand of every member block's MMA. z[p][col] gets the fp32 sum.
+#include "exl3_grouped.cuh"
+#include "exl3_prompt.cuh"
+namespace inkling2 {
+using namespace tf_exl3_prompt;
+template <int K2>
+constexpr int pd_stage() { return TPM * TXS + 2 * 16 * TKT * tf_exl3::tile_words<K2>(); }  // halves a stage
+
+template <int K2, int CB>
+__device__ __forceinline__ void pd_decode(const uint32_t* tile, int lane, uint32_t (&b0)[2], uint32_t (&b1)[2]) {
+    uint32_t w[tf_exl3::lane_words<K2>()];
+    int word, offset;
+    tf_exl3::lane_start<K2>(lane, word, offset);
+#pragma unroll
+    for (int i = 0; i < tf_exl3::lane_words<K2>(); ++i) w[i] = tile[(word + i) % tf_exl3::tile_words<K2>()];
+    tf_exl3::decode_lane<K2, CB>(w, lane, b0, b1);
+}
+
+template <int K2, int CB>
+__device__ __forceinline__ void pd_main(const half* __restrict__ X, const uint32_t* __restrict__ T, const int* rows_sh, int cnt,
+                                        int K, int NTILES, int cb, half* stage, float (&acc)[TMT][TNB][4]) {
+    constexpr int TWD = tf_exl3::tile_words<K2>(), PIECES = TWD / 4, SH = pd_stage<K2>();
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int chunks = K / TBK;
+    const int nblocks = (cnt + 15) >> 4;
+#pragma unroll
+    for (int i = 0; i < TMT; ++i)
+#pragma unroll
+        for (int j = 0; j < TNB; ++j)
+#pragma unroll
+            for (int c = 0; c < 4; ++c) acc[i][j][c] = 0.f;
+    auto load = [&](int chunk) {
+        half* dst = stage + (size_t)(chunk % TSTAGES) * SH;
+        const int k0 = chunk * TBK;
+        for (int idx = threadIdx.x; idx < TPM * (TBK / 8); idx += TT) {
+            const int i = idx / (TBK / 8), j = idx % (TBK / 8);
+            if (i >= nblocks * 16) continue;
+            const int r = rows_sh[i];
+            cp_async16(dst + (size_t)i * TXS + j * 8, X + (size_t)(r < 0 ? 0 : r) * K + k0 + j * 8, r >= 0);
+        }
+        uint32_t* wdst = reinterpret_cast<uint32_t*>(dst + (size_t)TPM * TXS);
+        for (int idx = threadIdx.x; idx < 16 * TKT * PIECES; idx += TT) {
+            const int q = idx / (TKT * PIECES), kk = (idx / PIECES) % TKT, part = idx % PIECES;
+            const uint32_t* src = T + (((size_t)chunk * TKT + kk) * NTILES + cb * 16 + q) * TWD + part * 4;
+            cp_async16(wdst + ((size_t)q * TKT + kk) * TWD + part * 4, src, true);
+        }
+    };
+#pragma unroll
+    for (int c = 0; c < TSTAGES - 1; ++c) {
+        if (c < chunks) load(c);
+        cp_commit();
+    }
+    for (int c = 0; c < chunks; ++c) {
+        cp_wait<TSTAGES - 2>();
+        __syncthreads();
+        if (c + TSTAGES - 1 < chunks) load(c + TSTAGES - 1);
+        cp_commit();
+        const half* xs = stage + (size_t)(c % TSTAGES) * SH;
+        const uint32_t* ws = reinterpret_cast<const uint32_t*>(xs + (size_t)TPM * TXS);
+#pragma unroll
+        for (int kk = 0; kk < TKT; ++kk) {
+            uint32_t a[TMT][4];
+#pragma unroll
+            for (int i = 0; i < TMT; ++i) {
+                uint32_t b0[2], b1[2];
+                pd_decode<K2, CB>(ws + ((size_t)(warp * TMT + i) * TKT + kk) * TWD, lane, b0, b1);
+                a[i][0] = b0[0]; a[i][1] = b1[0]; a[i][2] = b0[1]; a[i][3] = b1[1];
+            }
+#pragma unroll
+            for (int jb = 0; jb < TPM / 16; ++jb) {
+                if (jb < nblocks) {
+                    uint32_t r[4];
+                    const int row = jb * 16 + (lane & 7) + ((lane >> 4) & 1) * 8;
+                    ldmatrix4(r, xs + (size_t)row * TXS + kk * 16 + ((lane >> 3) & 1) * 8);
+                    const uint32_t bl[2] = {r[0], r[1]}, bh[2] = {r[2], r[3]};
+#pragma unroll
+                    for (int i = 0; i < TMT; ++i) {
+                        mma16816(acc[i][2 * jb], a[i], bl);
+                        mma16816(acc[i][2 * jb + 1], a[i], bh);
+                    }
+                }
+            }
+        }
+    }
+    cp_wait<0>();
+}
+}  // namespace inkling2
+
+// Grid (n / 256, item), 256 threads; standard plans of up to 64 members (items of expert, first, count); z split 0.
+extern "C" __global__ void __launch_bounds__(256) tf_ik_prompt_dot(const tf_exl3::GroupedArgs a) {
+    using namespace tf_exl3_prompt;
+    const int cb = blockIdx.x, item = blockIdx.y;
+    if (item >= a.ucount[0]) return;
+    const int e = a.uids[3 * item];
+    if (e == a.skip) return;
+    const int first = a.uids[3 * item + 1], cnt = a.uids[3 * item + 2];
+    __shared__ int rows_sh[TPM];
+    __shared__ __align__(16) half stage[TSTAGES * inkling2::pd_stage<8>()];
+    if (threadIdx.x < TPM) rows_sh[threadIdx.x] = (int)threadIdx.x < cnt ? a.members[first + threadIdx.x] : -1;
+    __syncthreads();
+    const uint32_t* T = reinterpret_cast<const uint32_t*>(a.tp0[e]);
+    float acc[TMT][TNB][4];
+    switch (a.k2_0[e]) {
+#define TF_IK_PD_CASE(K2_)                                                                           \
+    case K2_:                                                                                        \
+        inkling2::pd_main<K2_, 2>(a.x0, T, rows_sh, cnt, a.k, a.n >> 4, cb, stage, acc);             \
+        break;
+        TF_IK_PD_CASE(2)
+        TF_IK_PD_CASE(3)
+        TF_IK_PD_CASE(4)
+        TF_IK_PD_CASE(5)
+        TF_IK_PD_CASE(6)
+        TF_IK_PD_CASE(7)
+        TF_IK_PD_CASE(8)
+#undef TF_IK_PD_CASE
+        default:
+            __trap();
+    }
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31, g = lane >> 2, t = lane & 3;
+    const int nblocks = (cnt + 15) >> 4;
+#pragma unroll
+    for (int i = 0; i < TMT; ++i) {
+        const int col = (cb * 16 + warp * TMT + i) * 16 + g;
+#pragma unroll
+        for (int nb = 0; nb < TNB; ++nb) {
+            if (nb / 2 >= nblocks) continue;
+            const int r0 = rows_sh[nb * 8 + 2 * t], r1 = rows_sh[nb * 8 + 2 * t + 1];
+            if (r0 >= 0) {
+                a.z[(size_t)r0 * a.n + col] = acc[i][nb][0];
+                a.z[(size_t)r0 * a.n + col + 8] = acc[i][nb][2];
+            }
+            if (r1 >= 0) {
+                a.z[(size_t)r1 * a.n + col] = acc[i][nb][1];
+                a.z[(size_t)r1 * a.n + col + 8] = acc[i][nb][3];
+            }
+        }
+    }
+}
