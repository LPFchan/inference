diff --git a/zig/src/families/inkling2/vision.zig b/zig/src/families/inkling2/vision.zig
new file mode 100644
index 00000000..d374a852
--- /dev/null
+++ b/zig/src/families/inkling2/vision.zig
@@ -0,0 +1,286 @@
+//! Inkling 2's image tower on CUDA as SGLang's inkling2_vision.py: an image's 20x20 patches to the language model's
+//! rows, one row a 40x40 tile (2 x 2 patches). Rank 0 holds it; its buffers are sized once for the largest image.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const cfg = @import("config.zig");
+const wt = @import("weights.zig");
+
+pub const width = 1024;
+pub const heads = 16;
+pub const head_dim = 64;
+pub const mlp = 4096;
+pub const depth = 23;
+pub const patch = 20; // a patch's side in pixels
+pub const tile = 2 * patch; // an image token's side: its 2 x 2 patches
+pub const patch_in = 3 * patch * patch; // a patch's pixels, (py, px, channel)
+pub const grid = 32; // the position grid's side
+pub const proj = 4096;
+const eps: f32 = 1e-5;
+const chunk = 1024; // rows a linear's fp32 product covers
+const prefix = "model.visual.";
+
+const Layer = struct { ln1_w: u64, ln1_b: u64, qkv_w: u64, qkv_b: u64, out_w: u64, out_b: u64, ls1: u64, ln2_w: u64, ln2_b: u64, fc_w: u64, fc_b: u64, proj_w: u64, proj_b: u64, ls2: u64 };
+
+pub const Funcs = struct {
+    embed: cuda.Function,
+    cls: cuda.Function,
+    ln: cuda.Function,
+    bias: cuda.Function,
+    residual: cuda.Function,
+    qkv: cuda.Function,
+    merge: cuda.Function,
+    inject: cuda.Function,
+
+    pub fn load(m: cuda.Module) !Funcs {
+        var f: Funcs = undefined;
+        inline for (@typeInfo(Funcs).@"struct".field_names) |name| @field(f, name) = try m.function("ikv_" ++ name);
+        return f;
+    }
+};
+
+/// The device bytes the tower's buffers take for images of at most `tokens` tokens (its weights aside).
+pub fn scratchBytes(tokens: usize) usize {
+    const n = 4 * tokens + 1;
+    return 5 * n * width * 2 + chunk * cfg.hidden * 4 + chunk * mlp * 2 + chunk * patch_in * 2 + n * 8 + 8 * 256;
+}
+
+const Plan = struct { m: usize, n: usize, k: usize, out: cuda.cublaslt.DataType, plan: cuda.cublaslt.Linear };
+
+pub const Tower = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    lt: *const cuda.cublaslt.Library,
+    ws: u64, // the forward's cuBLASLt workspace: the tower runs on its stream, between its passes
+    ws_len: usize,
+    f: Funcs,
+    at: cuda.vit.Attention, // prefill_attention.cu's vision_kernel<64>: every row over every row
+    mem: cuda.DeviceBuffer,
+    scratch: cuda.DeviceBuffer,
+    max_tokens: usize,
+    layers: [depth]Layer = undefined,
+    patch_w: u64 = 0,
+    pos_grid: u64 = 0,
+    cls: u64 = 0,
+    cls_pos: u64 = 0,
+    pre_w: u64 = 0,
+    pre_b: u64 = 0,
+    proj_in: u64 = 0,
+    proj_out: u64 = 0,
+    inv_freq: u64 = 0,
+    plans: std.ArrayList(Plan) = .empty, // one encode's: its shapes follow the image's size
+
+    /// The tower's tensors from `path` (the checkpoint's dense/vision.safetensors), q, k and v as one projection.
+    pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, lt: *const cuda.cublaslt.Library, ws: u64, ws_len: usize, f: Funcs, path: []const u8, max_tokens: usize) !Tower {
+        var file = try core.safetensors.File.open(gpa, io, path);
+        defer file.closeCopied(io);
+        const L = struct { name: []const u8, shape: []const usize };
+        const one: []const L = &.{
+            .{ .name = "backbone.embeddings.patch_embedding.weight", .shape = &.{ width, patch_in } },
+            .{ .name = "backbone.embeddings.position_embedding", .shape = &.{ grid * grid, width } },
+            .{ .name = "backbone.embeddings.class_embedding", .shape = &.{width} },
+            .{ .name = "backbone.embeddings.cls_position_embedding", .shape = &.{width} },
+            .{ .name = "backbone.ln_pre.weight", .shape = &.{width} },
+            .{ .name = "backbone.ln_pre.bias", .shape = &.{width} },
+            .{ .name = "proj_in.weight", .shape = &.{ proj, 4 * width } },
+            .{ .name = "proj_out.weight", .shape = &.{ cfg.hidden, proj } },
+        };
+        const each: []const L = &.{
+            .{ .name = "ln_1.weight", .shape = &.{width} },          .{ .name = "ln_1.bias", .shape = &.{width} },
+            .{ .name = "self_attn.q_proj.weight", .shape = &.{ width, width } }, .{ .name = "self_attn.k_proj.weight", .shape = &.{ width, width } },
+            .{ .name = "self_attn.v_proj.weight", .shape = &.{ width, width } }, .{ .name = "self_attn.q_proj.bias", .shape = &.{width} },
+            .{ .name = "self_attn.k_proj.bias", .shape = &.{width} }, .{ .name = "self_attn.v_proj.bias", .shape = &.{width} },
+            .{ .name = "self_attn.out_proj.weight", .shape = &.{ width, width } }, .{ .name = "self_attn.out_proj.bias", .shape = &.{width} },
+            .{ .name = "ls_1.gamma", .shape = &.{width} },            .{ .name = "ln_2.weight", .shape = &.{width} },
+            .{ .name = "ln_2.bias", .shape = &.{width} },             .{ .name = "mlp.c_fc.weight", .shape = &.{ mlp, width } },
+            .{ .name = "mlp.c_fc.bias", .shape = &.{mlp} },           .{ .name = "mlp.c_proj.weight", .shape = &.{ width, mlp } },
+            .{ .name = "mlp.c_proj.bias", .shape = &.{width} },       .{ .name = "ls_2.gamma", .shape = &.{width} },
+        };
+        var nb: [96]u8 = undefined;
+        var total: usize = 16 * 4 + 256;
+        for (one) |e| total += std.mem.alignForward(usize, (try tensor(&file, e.name, e.shape)).len, 256);
+        for (0..depth) |i| for (each) |e| {
+            total += std.mem.alignForward(usize, (try tensor(&file, try layerName(&nb, i, e.name), e.shape)).len, 256);
+        };
+        var at_ = try cuda.vit.Attention.load(d);
+        errdefer at_.unload();
+        var t: Tower = .{ .gpa = gpa, .d = d, .lt = lt, .ws = ws, .ws_len = ws_len, .f = f, .at = at_, .mem = try cuda.DeviceBuffer.alloc(d, total), .scratch = undefined, .max_tokens = max_tokens };
+        errdefer t.mem.free();
+        t.scratch = try cuda.DeviceBuffer.alloc(d, scratchBytes(max_tokens));
+        errdefer t.scratch.free();
+        var at: u64 = t.mem.ptr;
+        const put = struct {
+            fn copy(dv: *const cuda.Driver, p: *u64, data: []const u8) !u64 {
+                const r = p.*;
+                try cuda.copy_source.synchronousCopy(dv, r, data, std.heap.page_allocator);
+                p.* += std.mem.alignForward(u64, data.len, 256);
+                return r;
+            }
+        }.copy;
+        const ptrs = [_]*u64{ &t.patch_w, &t.pos_grid, &t.cls, &t.cls_pos, &t.pre_w, &t.pre_b, &t.proj_in, &t.proj_out };
+        for (one, ptrs) |e, p| p.* = try put(d, &at, try tensor(&file, e.name, e.shape));
+        for (&t.layers, 0..) |*l, i| {
+            var v: [each.len]u64 = undefined;
+            for (each, 0..) |e, j| v[j] = try put(d, &at, try tensor(&file, try layerName(&nb, i, e.name), e.shape));
+            // q, k and v back to back (each a multiple of 256 bytes): one [3 width, width] projection, one [3 width] bias
+            if (v[3] != v[2] + width * width * 2 or v[4] != v[3] + width * width * 2 or v[6] != v[5] + width * 2 or v[7] != v[6] + width * 2) return error.InklingTensorShape;
+            l.* = .{ .ln1_w = v[0], .ln1_b = v[1], .qkv_w = v[2], .qkv_b = v[5], .out_w = v[8], .out_b = v[9], .ls1 = v[10], .ln2_w = v[11], .ln2_b = v[12], .fc_w = v[13], .fc_b = v[14], .proj_w = v[15], .proj_b = v[16], .ls2 = v[17] };
+        }
+        // the rotary's frequencies: 10000^(-4i / 64), i = 0 .. 15 (a quarter of a head: each axis turns half its pairs)
+        var inv: [16]f32 = undefined;
+        for (&inv, 0..) |*x, i| x.* = @floatCast(std.math.pow(f64, 10000.0, -@as(f64, @floatFromInt(4 * i)) / head_dim));
+        t.inv_freq = try put(d, &at, std.mem.sliceAsBytes(&inv));
+        return t;
+    }
+
+    fn tensor(file: *const core.safetensors.File, name: []const u8, shape: []const usize) ![]const u8 {
+        var full: [128]u8 = undefined;
+        return (try wt.get(file, try std.fmt.bufPrint(&full, prefix ++ "{s}", .{name}), .bf16, shape)).bytes;
+    }
+
+    fn layerName(nb: *[96]u8, i: usize, name: []const u8) ![]const u8 {
+        return std.fmt.bufPrint(nb, "backbone.layers.{d}.{s}", .{ i, name });
+    }
+
+    pub fn deinit(t: *Tower) void {
+        t.dropPlans();
+        t.plans.deinit(t.gpa);
+        t.scratch.free();
+        t.mem.free();
+        t.at.unload();
+    }
+
+    fn dropPlans(t: *Tower) void {
+        for (t.plans.items) |*p| p.plan.deinit();
+        t.plans.clearRetainingCapacity();
+    }
+
+    /// The tower's device bytes: weights and buffers.
+    pub fn bytes(t: *const Tower) usize {
+        return t.mem.len + t.scratch.len;
+    }
+
+    /// D[m, n] = X[m, k] . W[n, k]^T, fp32 or bf16 out.
+    fn linear(t: *Tower, s: cuda.Stream, x: u64, w: u64, out: u64, m: usize, n: usize, k: usize, kind: cuda.cublaslt.DataType) !void {
+        for (t.plans.items) |*p| if (p.m == m and p.n == n and p.k == k and p.out == kind) return p.plan.run(x, w, out, t.ws, t.ws_len, s.handle);
+        var p = try cuda.cublaslt.Linear.init(t.lt, m, n, k, kind, t.ws_len);
+        errdefer p.deinit();
+        try t.plans.append(t.gpa, .{ .m = m, .n = n, .k = k, .out = kind, .plan = p });
+        try p.run(x, w, out, t.ws, t.ws_len, s.handle);
+    }
+
+    fn go(f: cuda.Function, s: cuda.Stream, blocks: usize, threads: u32, args: anytype) !void {
+        var a: cuda.Args = .{};
+        inline for (args) |v| a.add(v);
+        try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(blocks) }, .block = .{ .x = threads } }, s, &a);
+    }
+
+    fn grid1(n: usize) usize {
+        return @min((n + 255) / 256, 65535);
+    }
+
+    /// An image's patches (`pixels`: [gh gw, patch_in], the tower's input values, raster order) to its rows at `out`
+    /// ([gh gw / 4, hidden] bf16, raster order of tiles), on `s`; waits for the device before it returns.
+    pub fn encode(t: *Tower, s: cuda.Stream, pixels: []const f32, gh: usize, gw: usize, out: u64) !void {
+        defer t.dropPlans();
+        if (gh < 2 or gw < 2 or gh % 2 != 0 or gw % 2 != 0) return error.InklingImageGrid;
+        const tokens = gh * gw / 4;
+        if (tokens > t.max_tokens or pixels.len != gh * gw * patch_in) return error.InklingImageGrid;
+        const n = gh * gw + 1; // the class row, then each patch
+        const f = t.f;
+        var at: u64 = t.scratch.ptr;
+        const take = struct {
+            fn next(p: *u64, len: usize) u64 {
+                const r = p.*;
+                p.* += std.mem.alignForward(u64, len, 256);
+                return r;
+            }
+        }.next;
+        const nmax = 4 * t.max_tokens + 1;
+        const x = take(&at, nmax * width * 2);
+        const xn = take(&at, nmax * width * 2); // a layer's normed rows, then its attention's output
+        const qkv = take(&at, 3 * nmax * width * 2); // [n, 3 width]; at the end the merged tiles, then proj_in's GELU
+        const merged = qkv;
+        const hidden_in = qkv + nmax * width * 2;
+        const acc = take(&at, chunk * cfg.hidden * 4);
+        const hid = take(&at, chunk * mlp * 2);
+        const pin = take(&at, chunk * patch_in * 2);
+        const pos = take(&at, nmax * 8);
+        if (at > t.scratch.ptr + t.scratch.len) return error.InklingImageGrid;
+        { // each row's (row, column) for the rotary: the class row (0, 0), patch (y, x) at (y + 1, x + 1)
+            const host = try t.gpa.alloc(i32, 2 * n);
+            defer t.gpa.free(host);
+            host[0] = 0;
+            host[1] = 0;
+            for (0..gh * gw) |i| {
+                host[2 + 2 * i] = @intCast(i / gw + 1);
+                host[3 + 2 * i] = @intCast(i % gw + 1);
+            }
+            try cuda.copy_source.enqueue(t.d, pos, std.mem.sliceAsBytes(host), s);
+        }
+        try go(f.cls, s, 1, 256, .{ t.cls, t.cls_pos, x, @as(i32, width) });
+        { // the patch embedding (no bias) plus the position grid at each patch, a chunk of rows at a time
+            const half = try t.gpa.alloc(u16, chunk * patch_in);
+            defer t.gpa.free(half);
+            var r: usize = 0;
+            while (r < n - 1) : (r += chunk) {
+                const rows: usize = @min(chunk, n - 1 - r);
+                for (pixels[r * patch_in ..][0 .. rows * patch_in], half[0 .. rows * patch_in]) |v, *h| h.* = bf16(v);
+                try cuda.copy_source.enqueue(t.d, pin, std.mem.sliceAsBytes(half[0 .. rows * patch_in]), s);
+                try t.linear(s, pin, t.patch_w, acc, rows, width, patch_in, .f32);
+                try go(f.embed, s, rows, 256, .{ acc, t.pos_grid, x, @as(i32, @intCast(r)), @as(i32, @intCast(gh)), @as(i32, @intCast(gw)), @as(i32, width), @as(i32, grid) });
+            }
+        }
+        try go(f.ln, s, n, 256, .{ x, t.pre_w, t.pre_b, x, @as(i32, width), eps });
+        const scale: f32 = 1.0 / @sqrt(@as(f32, head_dim));
+        for (t.layers) |l| {
+            try go(f.ln, s, n, 256, .{ x, l.ln1_w, l.ln1_b, xn, @as(i32, width), eps });
+            var r: usize = 0;
+            while (r < n) : (r += chunk) {
+                const rows: usize = @min(chunk, n - r);
+                try t.linear(s, xn + r * width * 2, l.qkv_w, acc, rows, 3 * width, width, .f32);
+                try go(f.qkv, s, (rows * heads + 7) / 8, 256, .{ acc, l.qkv_b, pos, t.inv_freq, qkv, @as(i32, @intCast(r)), @as(i32, @intCast(rows)), @as(i32, heads) });
+            }
+            try t.at.full(s, qkv, xn, n, heads, head_dim, scale); // every row over every row of the image, into xn
+            r = 0;
+            while (r < n) : (r += chunk) {
+                const rows: usize = @min(chunk, n - r);
+                try t.linear(s, xn + r * width * 2, l.out_w, acc, rows, width, width, .f32);
+                try go(f.residual, s, grid1(rows * width), 256, .{ acc, l.out_b, l.ls1, x + r * width * 2, @as(i64, @intCast(rows * width)), @as(i32, width) });
+            }
+            try go(f.ln, s, n, 256, .{ x, l.ln2_w, l.ln2_b, xn, @as(i32, width), eps });
+            r = 0;
+            while (r < n) : (r += chunk) {
+                const rows: usize = @min(chunk, n - r);
+                try t.linear(s, xn + r * width * 2, l.fc_w, acc, rows, mlp, width, .f32);
+                try go(f.bias, s, grid1(rows * mlp), 256, .{ acc, l.fc_b, hid, @as(i64, @intCast(rows * mlp)), @as(i32, mlp), @as(i32, 1) });
+                try t.linear(s, hid, l.proj_w, acc, rows, width, mlp, .f32);
+                try go(f.residual, s, grid1(rows * width), 256, .{ acc, l.proj_b, l.ls2, x + r * width * 2, @as(i64, @intCast(rows * width)), @as(i32, width) });
+            }
+        }
+        // each tile's four patches side by side, the projection in and its GELU, the projection out
+        try go(f.merge, s, tokens, 256, .{ x, merged, @as(i32, @intCast(gw / 2)), @as(i32, width) });
+        var r: usize = 0;
+        while (r < tokens) : (r += chunk) {
+            const rows: usize = @min(chunk, tokens - r);
+            try t.linear(s, merged + r * 4 * width * 2, t.proj_in, acc, rows, proj, 4 * width, .f32);
+            try go(f.bias, s, grid1(rows * proj), 256, .{ acc, @as(u64, 0), hidden_in + r * proj * 2, @as(i64, @intCast(rows * proj)), @as(i32, proj), @as(i32, 1) });
+            try t.linear(s, hidden_in + r * proj * 2, t.proj_out, out + r * cfg.hidden * 2, rows, cfg.hidden, proj, .bf16);
+        }
+        try s.synchronize(); // the encode's plans go on return
+    }
+};
+
+/// `v` (a bf16 value held in fp32) as bf16 bits, rounded to nearest even.
+pub fn bf16(v: f32) u16 {
+    const b: u32 = @bitCast(v);
+    if (std.math.isNan(v)) return @truncate((b >> 16) | 0x40);
+    return @truncate((b + 0x7fff + ((b >> 16) & 1)) >> 16);
+}
+
+test "the tower's buffers grow with its largest image" {
+    try std.testing.expect(scratchBytes(4096) < 200 << 20);
+    try std.testing.expect(scratchBytes(1) < 40 << 20);
+    try std.testing.expectEqual(@as(u16, 0x3f80), bf16(1.0));
+    try std.testing.expectEqual(@as(u16, 0xbf81), bf16(-1.0078125));
+}
