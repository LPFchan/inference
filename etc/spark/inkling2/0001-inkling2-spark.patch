-extern "C" __global__ void tf_ik_top1(const float* x, InklingPick* out, int count, int first) {
+
+// A slot's draw: its request's seed and 1 / T (0: greedy).
+struct IkDraw { unsigned seed_lo, seed_hi; float inv_t; unsigned pad; };
+// lanes/sampling.zig's mix and keyBits(seed, position, id), so a draw is keyed like every other sampler's
+__device__ __forceinline__ unsigned long long ik_mix(unsigned long long x) {
+    x ^= x >> 30;
+    x *= 0xBF58476D1CE4E5B9ull;
+    x ^= x >> 27;
+    x *= 0x94D049BB133111EBull;
+    return x ^ (x >> 31);
+}
+// Gumbel noise -log(-log(u)) for u = (k + 0.5) / 2^32, k the key's top 32 bits; -log(u) through log1p for u past
+// one half, so the tail that decides close calls keeps its precision
+__device__ __forceinline__ float ik_gumbel(unsigned long long base, unsigned id) {
+    const unsigned k = (unsigned)(ik_mix(base ^ id) >> 32);
+    const float e = k >= 0x80000000u ? -log1pf(-(((float)(0xffffffffu - k) + 0.5f) * 2.3283064365386963e-10f))
+                                     : -logf(((float)k + 0.5f) * 2.3283064365386963e-10f);
+    return -logf(e);
+}
+
+// The largest of a rank's `count` logits (token first + i) with its index; with a draw, of x / T plus each token's
+// Gumbel noise at the drawn token's position (pos, or *posp under a captured graph, plus ahead): the argmax over every
+// rank is then a sample at temperature T, the same on each rank and with or without drafts.
+extern "C" __global__ void tf_ik_top1(const float* x, InklingPick* out, int count, int first, const IkDraw* draw, int pos,
+                                      const int* posp, int ahead) {
     __shared__ float values[256];
     __shared__ int ids[256], bad[256];
     const int t = threadIdx.x;
     float value = -INFINITY;
     int id = 0x7fffffff, nonfinite = 0;
+    const float inv_t = draw ? draw->inv_t : 0.f;
+    unsigned long long base = 0;
+    if (inv_t > 0.f) {
+        const unsigned long long seed = ((unsigned long long)draw->seed_hi << 32) | draw->seed_lo;
+        const unsigned long long at = (unsigned long long)((long long)(posp ? *posp : pos) + ahead);
+        base = ik_mix(ik_mix(seed + 0x9E3779B97F4A7C15ull) ^ (at * 0xD1B54A32D192ED03ull));
+    }
     for (int i = t; i < count; i += 256) {
-        const float v = x[i];
+        float v = x[i];
         nonfinite |= !isfinite(v);
+        if (inv_t > 0.f) v = v * inv_t + ik_gumbel(base, (unsigned)(i + first));
