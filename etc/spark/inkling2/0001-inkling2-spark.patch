diff --git a/zig/src/families/inkling2/fp4.zig b/zig/src/families/inkling2/fp4.zig
new file mode 100644
index 00000000..958ff591
--- /dev/null
+++ b/zig/src/families/inkling2/fp4.zig
@@ -0,0 +1,72 @@
+//! TF_INKLING_FP4: Inkling's BF16 attention (and head) projections as NVFP4 lane weights, quantized on the device at load.
+const std = @import("std");
+const cuda = @import("cuda");
+const kern = @import("kernels.zig");
+const wt = @import("weights.zig");
+
+/// off; attn: Q, K, V, R, gate and O; all: those and the output head. Router, sink and conv projections stay BF16.
+pub const Set = enum(u8) { off, attn, all };
+
+const attn = [_][]const u8{ "attn.wq_du.weight", "attn.wk_dv.weight", "attn.wv_dv.weight", "attn.wr_du.weight", "attn.wo_ud.weight", "attn.gate_attn.weight" };
+const head = "model.llm.unembed.weight";
+
+pub fn wants(set: Set, name: []const u8) bool {
+    if (set == .off) return false;
+    if (set == .all and std.mem.eql(u8, name, head)) return true;
+    for (attn) |s| if (std.mem.endsWith(u8, name, s)) return true;
+    return false;
+}
+
+pub const Quant = struct {
+    k: *const kern.Kernels,
+    packer: cuda.modelopt.Packer,
+    stream: cuda.Stream,
+    amax: cuda.DeviceBuffer,
+    set: Set,
+
+    pub fn init(d: *const cuda.Driver, k: *const kern.Kernels, set: Set) !Quant {
+        var packer = try cuda.modelopt.Packer.load(d);
+        errdefer packer.unload();
+        var stream = try cuda.Stream.init(d, false);
+        errdefer stream.deinit();
+        return .{ .k = k, .packer = packer, .stream = stream, .amax = try cuda.DeviceBuffer.alloc(d, 4), .set = set };
+    }
+
+    pub fn deinit(q: *Quant) void {
+        q.amax.free();
+        q.stream.deinit();
+        q.packer.unload();
+    }
+
+    /// bf16 [n, k] at `src` as a packed `.nvfp4` lane weight whose words and scale tiles `w` owns.
+    pub fn pack(q: *const Quant, w: *wt.Weights, src: u64, n: usize, k: usize) !cuda.qmmf.Weight {
+        if (k % 64 != 0) return error.InklingTensorShape;
+        const groups = n * k / 16;
+        var codes = try cuda.DeviceBuffer.alloc(w.d, groups * 8);
+        defer codes.free();
+        var scales = try cuda.DeviceBuffer.alloc(w.d, groups);
+        defer scales.free();
+        try q.amax.fill32(0, q.stream.handle);
+        try q.k.go(.fp4_amax, q.stream, .{ .x = 1024 }, 256, .{ src, @as(i64, @intCast(n * k)), q.amax.ptr });
+        try q.k.go(.fp4_quant, q.stream, .{ .x = kern.ceil(groups, 256) }, 256, .{ src, codes.ptr, scales.ptr, q.amax.ptr, @as(i64, @intCast(groups)) });
+        const npad = cuda.nvfp4.padded(n);
+        const words = try w.alloc(npad / 64 * (k / 64) * 512 * 4);
+        const tiles = try w.alloc(npad * (k / 16));
+        try q.packer.fp4Lane(q.stream, codes.ptr, scales.ptr, words, tiles, n, k);
+        try q.stream.synchronize();
+        var bits: [4]u8 = undefined;
+        try q.amax.download(0, &bits);
+        const amax: f32 = @bitCast(std.mem.readInt(u32, &bits, .little));
+        return cuda.nvfp4.weight(words, tiles, @max(amax, 1e-30) / 2688.0, n, k);
+    }
+};
+
+test "TF_INKLING_FP4 picks attention projections and, with all, the head" {
+    try std.testing.expect(wants(.attn, "model.llm.layers.3.attn.wq_du.weight"));
+    try std.testing.expect(wants(.attn, "model.llm.layers.47.attn.wo_ud.weight"));
+    try std.testing.expect(!wants(.attn, "model.llm.layers.3.attn.attn_sink_proj.weight"));
+    try std.testing.expect(!wants(.attn, "model.llm.layers.3.mlp.gate.weight"));
+    try std.testing.expect(!wants(.attn, head));
+    try std.testing.expect(wants(.all, head));
+    try std.testing.expect(!wants(.off, "model.llm.layers.3.attn.wq_du.weight"));
+}
