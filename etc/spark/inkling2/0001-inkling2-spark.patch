+test "chunk planner splits by token cap, defers straddlers, skips cached prefix and reuses held straddlers" {
+    const mk = struct {
+        fn f(at: u32, tokens: u32) lanes.stream.Image {
+            return .{ .pixels = &.{}, .gh = 2, .gw = tokens * 2, .at = at, .tokens = tokens };
+        }
+    }.f;
+    // 5 images of 1000 tokens each inside a 10000-token chunk with 2500-token buffer: splits 2 + 2 + 1
+    const five = [_]lanes.stream.Image{ mk(100, 1000), mk(1200, 1000), mk(2300, 1000), mk(3400, 1000), mk(4500, 1000) };
+    const p1 = planChunkWith(null, 0, &five, 0, 10000, 2500, 64);
+    try std.testing.expectEqual(@as(usize, 2300), p1.end);
+    try std.testing.expectEqual(@as(usize, 2), p1.batch.len);
+    const p2 = planChunkWith(null, 0, &five, 2300, 10000, 2500, 64);
+    try std.testing.expectEqual(@as(usize, 4500), p2.end);
+    try std.testing.expectEqual(@as(usize, 2), p2.batch.len);
+    const p3 = planChunkWith(null, 0, &five, 4500, 10000, 2500, 64);
+    try std.testing.expectEqual(@as(usize, 10000), p3.end);
+    try std.testing.expectEqual(@as(usize, 1), p3.batch.len);
+
+    // cached prefix past all 5 images returns empty batch and full chunk
+    const cached = planChunkWith(null, 0, &five, 5500, 10000, 2500, 64);
+    try std.testing.expectEqual(@as(usize, 10000), cached.end);
+    try std.testing.expectEqual(@as(usize, 0), cached.batch.len);
+
+    // straddling image starting after `from` is deferred to the next chunk
+    const straddle = [_]lanes.stream.Image{mk(900, 300)};
+    const ps = planChunkWith(null, 0, &straddle, 0, 1000, 4096, 64);
+    try std.testing.expectEqual(@as(usize, 900), ps.end);
+    try std.testing.expectEqual(@as(usize, 0), ps.batch.len);
+
+    // already-held straddling image finishes before encoding the next image
+    const two = [_]lanes.stream.Image{ mk(0, 1000), mk(1200, 500) };
+    var v: Images = undefined;
+    v.spans = .empty;
+    defer v.spans.deinit(std.testing.allocator);
+    try v.spans.append(std.testing.allocator, .{ .at = 0, .n = 1000, .row = 0 });
+    v.owner = 0;
+    const pr = planChunkWith(&v, 0, &two, 500, 2000, 4096, 64);
+    try std.testing.expectEqual(@as(usize, 1200), pr.end);
+    try std.testing.expectEqual(@as(usize, 1), pr.batch.len);
+    try std.testing.expect(v.holds(0, pr.batch));
+
+    // span_cap trims batch cleanly
+    const sp = planChunkWith(null, 0, &five, 0, 10000, 10000, 2);
+    try std.testing.expectEqual(@as(usize, 2300), sp.end);
+    try std.testing.expectEqual(@as(usize, 2), sp.batch.len);
+}
