+// FP4 KV (TF_INKLING_KV4=1): the full-history caches of the global layers and the drafter's global layer as NVFP4
+// rows. A ring of `capacity` positions for `hk` key heads holds, head-major, 64 bytes of E2M1 codes a (head, position)
+// (values 8w..8w+7 in 32-bit word w, nibbles where tf_common::fp4pair reads them in pairs), then after every head's
+// codes the E4M3 scale of each 16 values, 8 bytes a (head, position). A value reads back as code x scale: a product
+// a bf16 holds exactly, so every reader (pairs or one value at a time) sees the same bits.
+#pragma once
+#include "inkling2_common.cuh"
+#include "common/fp_pairs.cuh"
+
+namespace ik_kv4 {
+__device__ __forceinline__ size_t row(int capacity, int head, int slot) { return (size_t)head * capacity + slot; }
+__device__ __forceinline__ size_t scales(int capacity, int hk) { return (size_t)hk * capacity * 64; }
+// value j (0..7) of a word: fp4pair(w, s) reads bits s and 16 + s, so pair j/2 sits at s = 4 (j/2), its odd value 16 up
+__device__ __forceinline__ int shift(int j) { return (j & 1) * 16 + (j >> 1) * 4; }
+
+// E2M1 of x: nearest, ties to the even code, saturated at 6
+__device__ __forceinline__ unsigned code(float x) {
+    const float a = fabsf(x);
+    const unsigned c = (a > 0.25f) + (a >= 0.75f) + (a > 1.25f) + (a >= 1.75f) + (a > 2.5f) + (a >= 3.5f) + (a > 5.f);
+    return c | (x < 0.f ? 8u : 0u);
+}
+__device__ __forceinline__ float value(unsigned c) {
+    const float m[8] = {0.f, 0.5f, 1.f, 1.5f, 2.f, 3.f, 4.f, 6.f};
+    return c & 8u ? -m[c & 7u] : m[c & 7u];
+}
+
+// Value c of (head, slot), held by thread c of 128 (whole warps, lanes in order, every lane present): its block of 16
+// takes the E4M3 of amax / 6 as scale, each value the E2M1 of value / scale.
+__device__ __forceinline__ void put(unsigned char* cache, int capacity, int hk, int head, int slot, int c, float x) {
+    float amax = fabsf(x);
+#pragma unroll
+    for (int o = 1; o < 16; o <<= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, o));
+    const unsigned s8 = __nv_cvt_float_to_fp8(amax / 6.f, __NV_SATFINITE, __NV_E4M3);
+    const float s = tf_common::e4m3f(s8);
+    unsigned w = (s > 0.f ? code(x / s) : 0u) << shift(c & 7);
+#pragma unroll
+    for (int o = 1; o < 8; o <<= 1) w |= __shfl_xor_sync(0xffffffffu, w, o);
+    const size_t r = row(capacity, head, slot);
+    if (!(c & 7)) reinterpret_cast<unsigned*>(cache)[r * 16 + c / 8] = w;
+    if (!(c & 15)) cache[scales(capacity, hk) + r * 8 + c / 16] = static_cast<unsigned char>(s8);
+}
+
+// Value c of (head, slot).
+__device__ __forceinline__ float get(const unsigned char* cache, int capacity, int hk, int head, int slot, int c) {
+    const size_t r = row(capacity, head, slot);
+    const unsigned w = reinterpret_cast<const unsigned*>(cache)[r * 16 + c / 8];
+    return value((w >> shift(c & 7)) & 15u) * tf_common::e4m3f(cache[scales(capacity, hk) + r * 8 + c / 16]);
+}
+
+// A word's eight values, in order, as four bf16 pairs (its block's scale s8).
+__device__ __forceinline__ uint4 unpack8(unsigned w, unsigned s8) {
+    const uint32_t s = tf_common::fp8pair(s8 | s8 << 8);
+    return make_uint4(tf_common::mul2(tf_common::fp4pair(w, 0), s), tf_common::mul2(tf_common::fp4pair(w, 4), s),
+                      tf_common::mul2(tf_common::fp4pair(w, 8), s), tf_common::mul2(tf_common::fp4pair(w, 12), s));
+}
+// Word `word` (values 8 word..) of (head, slot) and its block's scale: what unpack8 takes.
+__device__ __forceinline__ void load(const unsigned char* cache, int capacity, int hk, int head, int slot, int word, unsigned& w, unsigned& s8) {
+    const size_t r = row(capacity, head, slot);
+    w = reinterpret_cast<const unsigned*>(cache)[r * 16 + word];
+    s8 = cache[scales(capacity, hk) + r * 8 + word / 2];
+}
+}  // namespace ik_kv4
