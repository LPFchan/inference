+// tf_ik_draft_mix's tap sum one tap at a time, kept in f32 between taps: tap 0 starts it, the later ones add in order
+extern "C" __global__ void tf_ik_draft_gather(const bf16* x, const bf16* alpha, float* sums, int tap, int n) {
+    const int i = (blockIdx.x * blockDim.x + threadIdx.x) * 4;
+    if (i >= n) return;
+    const float a = f(alpha[tap]);
+    const uint2 raw = *reinterpret_cast<const uint2*>(x + i);
+    const bf16* in = reinterpret_cast<const bf16*>(&raw);
+    float4 v = tap ? *reinterpret_cast<const float4*>(sums + i) : make_float4(0.f, 0.f, 0.f, 0.f);
+    v.x += f(in[0]) * a;
+    v.y += f(in[1]) * a;
+    v.z += f(in[2]) * a;
+    v.w += f(in[3]) * a;
+    *reinterpret_cast<float4*>(sums + i) = v;
+}
+
+// tf_ik_draft_mix of rows whose tap sums tf_ik_draft_gather kept
+extern "C" __global__ void tf_ik_draft_mix_sum(const float* sums, const bf16* norm, bf16* out) {
+    const int row = blockIdx.x, t = threadIdx.x;
+    const float* v = sums + (size_t)row * 4608;
+    float square = 0.f;
+    for (int c = t; c < 4608; c += 256) square += v[c] * v[c];
+    const float scale = rsqrtf(sum(square) / 4608.f + 1e-6f);
+    for (int c = t; c < 4608; c += 256) out[row * 4608 + c] = b((v[c] * scale) * f(norm[c]));
+}
