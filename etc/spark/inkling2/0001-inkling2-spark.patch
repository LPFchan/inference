index 126984ce..ee5def65 100644
--- a/zig/kernels/cuda/inkling2_quant.cuh
+++ b/zig/kernels/cuda/inkling2_quant.cuh
@@ -6,65 +6,93 @@ using namespace inkling2;
 __device__ inline float ik_e4(float x) { return (float)__nv_fp8_e4m3(x); }
 __device__ inline float ik_e2(float x) { return (float)__nv_fp4_e2m1(x); }
 
-// A whole row's amax precedes the independent 16-value NVFP4 groups. One CTA owns the row.
+// One thread a 16-value group, all of a row's loads at once; a 32-value MXFP8 group is a thread pair.
+// The NVFP4 row amax precedes the independent groups. One CTA owns the row; blockDim covers width / 16 in whole warps.
 extern "C" __global__ void tf_ik_quant(const bf16* x, half* y, int width, int nvfp4) {
-    const int row = blockIdx.x, t = threadIdx.x;
