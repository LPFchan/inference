+// Decode and verify attention over FP4 rings, split over keys: CTA (key head, j) serves every query head of its key
+// head, (row, query head) pairs as the rows of the tensor-core tiles, so each tile of codes is loaded and widened once
+// for the whole group. It takes every gridDim.y-th 64-key tile by absolute key position, so a row's partials do not
+// depend on which other rows share the launch; tf_ik_attention_merge4 adds the gridDim.y partials in order. Per row
+// the arithmetic is tf_ik_attention_part's: the same products, the same probability limbs, the same reduction order.
+#pragma once
+#include "inkling2_attention_split.cuh"
+
+#define IK_MAX_SPLITS 128
+
+namespace ik_part4 {
+constexpr int D = 128, NK = 64, LD = D + 8, LP = NK + 8, LS = NK + 4; // padded rows: no shared bank conflicts
+template <int MT> struct Shared {
+    bf16 keys[NK][LD], values[NK][LD], q[MT > 1 ? MT * 16 : 1][LD]; // one tile's Q stays in registers
+    bf16 probabilities[3][MT * 16][LP];
+    float scores[MT * 16][LS], maxima[MT * 16], totals[MT * 16], alpha[MT * 16];
+    unsigned bad; // query heads (bit per head of the group) whose inputs take the exception path
+};
+template <int MT> constexpr size_t shared_bytes() { return sizeof(Shared<MT>); }
+
+__device__ __forceinline__ void ldm4(uint32_t (&r)[4], const void* p) {
+    const unsigned s = static_cast<unsigned>(__cvta_generic_to_shared(p));
+    asm volatile("ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%0,%1,%2,%3}, [%4];" : "=r"(r[0]), "=r"(r[1]), "=r"(r[2]), "=r"(r[3]) : "r"(s));
+}
+
+// One thread's share of a 64-key tile (NT threads): 16-byte pieces t + NT r (key piece / 4, words 4 (piece % 4)..) and
+// their two scales; keys past `last` read as zeros.
+template <int NT> struct Pieces { uint4 w[256 / NT]; unsigned s[256 / NT]; };
+template <int NT>
+__device__ __forceinline__ void fetch(Pieces<NT>& p, const unsigned char* cache, int capacity, int hk, int kh, int base, int last) {
+    const int sb = base % capacity;
+    const uint4* codes = reinterpret_cast<const uint4*>(cache);
+    const unsigned short* scales = reinterpret_cast<const unsigned short*>(cache + ik_kv4::scales(capacity, hk));
+#pragma unroll
+    for (int r = 0; r < 256 / NT; ++r) {
+        const int i = threadIdx.x + r * NT, key = i >> 2, q = i & 3;
+        p.w[r] = make_uint4(0, 0, 0, 0);
+        p.s[r] = 0;
+        if (base + key <= last) {
+            int slot = sb + key;
+            if (slot >= capacity) slot %= capacity;
+            const size_t row = ik_kv4::row(capacity, kh, slot);
+            p.w[r] = codes[row * 4 + q];
+            p.s[r] = scales[row * 4 + q];
+        }
+    }
+}
