@@ -142,6 +166,8 @@ extern "C" __global__ __launch_bounds__(128) void tf_ik_attention_flash(InklingA
         commit();
     }
     wait<0>();
+    // unrolled, so o stays in registers (an h-indexed o is a stack array)
