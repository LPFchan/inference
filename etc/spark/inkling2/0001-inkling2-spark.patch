new file mode 100644
index 00000000..04e00ea2
--- /dev/null
+++ b/zig/src/server/chat_inkling.zig
@@ -0,0 +1,32 @@
+//! Inkling 2's messages bypass the generic prose-to-tool parser, including in streamed replies (inkling_reply.zig).
+const std = @import("std");
+const reply_text = @import("reply_text.zig");
+const native = @import("inkling_reply.zig");
+const chat = @import("chat.zig");
+
+pub fn read(g: anytype, ids: []const u32, finished: bool) std.mem.Allocator.Error!@import("kimi_reply.zig").Result {
+    var result = if (g.chat) try native.parse(g.a, g.srv.text, ids, g.tools, finished) else @import("kimi_reply.zig").Result{ .content = try g.srv.text.decode(g.a, ids), .reasoning = "", .calls = null, .reasoning_tokens = 0 };
+    result.content = g.stops.visible(result.content, !finished);
+    result.reasoning = g.stops.visible(result.reasoning, !finished);
+    if (g.stops.strings.len > 0) {
+        const raw = try g.srv.text.decode(g.a, ids);
+        if (g.stops.matched(raw) != null) result.calls = null;
+    }
+    return result;
+}
+
+pub fn stream(g: anytype, sink: chat.Sink) chat.Failure!void {
+    const result = try read(g, reply_text.stripTrailing(g.collected.items, g.srv.eos), false);
+    const thought = reply_text.pyStrip(result.reasoning);
+    const reason = g.streamed_reasoning.after(thought, true);
+    if (reason.len > 0) {
+        try g.streamed_reasoning.set(g.a, thought, reason);
+        try g.emit(sink, try reply_text.deltaOf(g.a, "reasoning_content", reason));
+    }
+    const delta = g.streamed.after(result.content, true);
+    if (delta.len > 0) {
+        try g.streamed.set(g.a, result.content, delta);
+        try g.emit(sink, .{ .string = delta });
+    }
+    // Calls wait for the finished parse, as Kimi's do: a call is sent whole or not at all.
+}
diff --git a/zig/src/server/inkling_reply.zig b/zig/src/server/inkling_reply.zig
new file mode 100644
index 00000000..98adec7c
--- /dev/null
+++ b/zig/src/server/inkling_reply.zig
@@ -0,0 +1,122 @@
+//! Inkling 2's replies: a turn is a run of model messages (`<|message_model|>NAME?<|content_KIND|>…<|end_message|>`)
+//! ended by `<|content_model_end_sampling|>`. Text blocks are the answer, thinking blocks the reasoning, and
+//! `<|content_invoke_tool_json|>{"name":…,"args":{…}}` blocks the calls. Controls are read by id: ordinary text that
+//! spells a control stays text (SGLang's parser/inkling_output.py reads them the same way).
+const std = @import("std");
+const json = @import("json");
+const mt = @import("model_text.zig");
+const specs = @import("tool_specs.zig");
+const ids_mod = @import("ids.zig");
+const Result = @import("kimi_reply.zig").Result;
+const V = json.Value;
+const A = std.mem.Allocator;
+
+/// The control ids a reply is read by; null when the tokenizer is not Inkling's.
+pub const Ids = struct {
+    model: u32,
+    end: u32,
+    end_sampling: u32,
+    text: u32,
+    thinking: u32,
+    call: u32,
+
+    pub fn of(text: mt.Text) ?Ids {
+        return .{
+            .model = text.tokenId("<|message_model|>") orelse return null,
+            .end = text.tokenId("<|end_message|>") orelse return null,
+            .end_sampling = text.tokenId("<|content_model_end_sampling|>") orelse return null,
+            .text = text.tokenId("<|content_text|>") orelse return null,
+            .thinking = text.tokenId("<|content_thinking|>") orelse return null,
+            .call = text.tokenId("<|content_invoke_tool_json|>") orelse return null,
+        };
+    }
+};
+
+const Kind = enum { none, text, thinking, call, other };
+
+/// ``ids`` is the reply as sampled (the prompt ends before the model's header). ``finished``: a block still open at
+/// the end (max_tokens) is closed, its text kept; while streaming an open call stays hidden until its block closes.
+pub fn parse(a: A, text: mt.Text, ids: []const u32, offered: []const V, finished: bool) A.Error!Result {
+    const k = Ids.of(text) orelse return .{ .content = try text.decode(a, ids), .reasoning = "", .calls = null, .reasoning_tokens = 0, .rejected = true };
+    var content: std.ArrayList(u8) = .empty;
+    var thought: std.ArrayList(u8) = .empty;
+    var calls: std.ArrayList(V) = .empty;
+    var reasoning_tokens: usize = 0;
+    var rejected = false;
+    var kind: Kind = .none;
+    var in_header = false; // after <|message_model|>, before its content kind: the author's name
+    var start: usize = 0; // the open block's first payload token
+    var at: usize = 0;
+    while (at < ids.len) : (at += 1) {
+        const t = ids[at];
+        if (t == k.end_sampling and kind == .none) break;
+        if (kind == .none) {
+            if (t == k.model) {
+                in_header = true;
+            } else if (in_header and text.isSpecial(t)) {
+                in_header = false;
+                kind = if (t == k.text) .text else if (t == k.thinking) .thinking else if (t == k.call) .call else .other;
+                start = at + 1;
+            } else if (!in_header and !text.isSpecial(t)) {
+                // a headerless reply is text, as SGLang synthesizes its opener
+                kind = .text;
+                start = at;
+            }
+            continue;
+        }
+        if (t != k.end) continue;
+        try close(a, text, kind, ids[start..at], offered, &content, &thought, &calls, &reasoning_tokens, &rejected);
+        kind = .none;
+    }
+    if (kind != .none and (finished or kind != .call)) {
+        const open = ids[start..@min(at, ids.len)];
+        if (kind == .call) {
+            // cut by max_tokens: not executable, so its payload is the answer's text
+            try content.appendSlice(a, try text.decode(a, open));
+            rejected = true;
+        } else try close(a, text, kind, open, offered, &content, &thought, &calls, &reasoning_tokens, &rejected);
+    }
+    return .{ .content = content.items, .reasoning = thought.items, .calls = if (calls.items.len > 0) calls.items else null, .reasoning_tokens = reasoning_tokens, .rejected = rejected };
+}
+
+fn close(a: A, text: mt.Text, kind: Kind, payload: []const u32, offered: []const V, content: *std.ArrayList(u8), thought: *std.ArrayList(u8), calls: *std.ArrayList(V), reasoning_tokens: *usize, rejected: *bool) A.Error!void {
+    const s = try text.decode(a, payload);
+    switch (kind) {
+        .none => {},
+        .text, .other => try content.appendSlice(a, s),
+        .thinking => {
+            try thought.appendSlice(a, s);
+            reasoning_tokens.* += payload.len;
+        },
+        .call => if (try call(a, s, offered)) |c| try calls.append(a, c) else {
+            try content.appendSlice(a, s);
+            rejected.* = true;
+        },
+    }
+}
+
+/// `{"name": NAME, "args": {…}}` for an offered tool, as an OpenAI call; null when it is anything else.
+fn call(a: A, payload: []const u8, offered: []const V) A.Error!?V {
+    const parsed = switch (try json.parse(a, payload)) {
+        .ok => |v| v,
+        .err => return null,
+    };
+    if (parsed != .object) return null;
+    const name = parsed.object.get("name") orelse return null;
+    if (name != .string) return null;
+    var known = false;
+    for (offered) |tool| if (std.mem.eql(u8, try specs.toolName(a, tool), name.string)) {
+        known = true;
+    };
+    if (!known) return null;
+    const args = parsed.object.get("args") orelse V{ .object = try json.newObject(a) };
+    if (args != .object) return null;
+    const f = try json.newObject(a);
+    try f.put(a, "name", name);
+    try f.put(a, "arguments", .{ .string = try json.stringify(a, args, .{ .ascii = false, .compact = true }) });
+    const c = try json.newObject(a);
+    try c.put(a, "id", .{ .string = try ids_mod.make(a, "call_", 24) });
+    try c.put(a, "type", .{ .string = "function" });
+    try c.put(a, "function", .{ .object = f });
+    return .{ .object = c };
+}
diff --git a/zig/src/server/server.zig b/zig/src/server/server.zig
index 2dc2cf17..0778579c 100644
--- a/zig/src/server/server.zig
+++ b/zig/src/server/server.zig
@@ -156,6 +156,7 @@ pub const Server = struct {
     effort_levels: []const []const u8 = &.{},
     thinking_switch: bool = false,
     eos: []const u32 = &.{},
+    inkling: bool = false, // Inkling 2's messages: the reply is read by chat_inkling.zig
     think_close: []const u32 = &.{},
     think_close_end: ?u32 = null,
     metrics: metrics.Metrics,
@@ -232,6 +233,14 @@ pub const Server = struct {
         };
         const a = srv.arena.allocator();
         srv.eos = try a.dupe(u32, text.eosIds());
+        if (@import("inkling_reply.zig").Ids.of(text)) |k| {
+            // a turn is many messages: only the end of sampling ends it, not each message's end
+            srv.inkling = true;
+            var kept: std.ArrayList(u32) = .empty;
+            for (srv.eos) |t| if (t != k.end) try kept.append(a, t);
+            if (std.mem.indexOfScalar(u32, kept.items, k.end_sampling) == null) try kept.append(a, k.end_sampling);
+            srv.eos = kept.items;
+        }
         if (text.tokenId(reply_text.channel_markers.close) != null) srv.markers = reply_text.channel_markers;
         const minimax = text.tokenId(reply_text.mm_markers.close) != null;
         if (minimax) srv.markers = reply_text.mm_markers;
