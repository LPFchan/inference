@@ -0,0 +1,50 @@
+// NVFP4 for the BF16 projections at load: one fp32 tensor scale, an e4m3 scale a 16 inputs chosen by squared error.
+#pragma once
+#include "inkling2_common.cuh"
+using namespace inkling2;
+
+// The tensor's |w| max as fp32 bits (positive floats order as unsigned ints); *amax starts at 0.
+extern "C" __global__ void tf_ik_fp4_amax(const bf16* w, long long count, unsigned* amax) {
+    float m = 0.f;
+    for (long long i = blockIdx.x * (long long)blockDim.x + threadIdx.x; i < count; i += (long long)gridDim.x * blockDim.x)
+        m = fmaxf(m, fabsf(f(w[i])));
+    for (int o = 16; o; o >>= 1) m = fmaxf(m, __shfl_xor_sync(0xffffffffu, m, o));
+    if ((threadIdx.x & 31) == 0) atomicMax(amax, __float_as_uint(m));
+}
+
+// One thread a group: codes [n, k/2] (low nibble first) and e4m3 scales [n, k/16]; w ~ e2m1 * scale * (amax / 2688).
+// The scale is the group max's own e4m3 or one of the four below it (clipping the largest inputs), whichever errs least.
+extern "C" __global__ void tf_ik_fp4_quant(const bf16* w, uint2* codes, unsigned char* scales, const unsigned* amax, long long groups) {
+    const long long g = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    if (g >= groups) return;
+    const float global = fmaxf(__uint_as_float(*amax), 1e-30f) / 2688.f;
+    float x[16], m = 0.f;
+#pragma unroll
+    for (int j = 0; j < 16; ++j) {
+        x[j] = f(w[g * 16 + j]);
+        m = fmaxf(m, fabsf(x[j]));
+    }
+    const int base = __nv_fp8_e4m3(m / 6.f / global).__x;
+    int pick = base;
+    float best = INFINITY;
+    for (int c = max(base - 4, 1); c <= min(base + 1, 126); ++c) {
+        __nv_fp8_e4m3 s;
+        s.__x = (unsigned char)c;
+        const float scale = (float)s * global, inv = 1.f / scale;
+        float e = 0.f;
+#pragma unroll
+        for (int j = 0; j < 16; ++j) {
+            const float d = x[j] - (float)__nv_fp4_e2m1(x[j] * inv) * scale;
+            e += d * d;
+        }
+        if (e < best) best = e, pick = c;
+    }
+    __nv_fp8_e4m3 s;
+    s.__x = (unsigned char)pick;
+    const float inv = pick ? 1.f / ((float)s * global) : 0.f;
+    unsigned word[2] = {0, 0};
+#pragma unroll
+    for (int j = 0; j < 16; ++j) word[j / 8] |= (unsigned)(__nv_fp4_e2m1(x[j] * inv).__x & 0xF) << (4 * (j % 8));
+    codes[g] = make_uint2(word[0], word[1]);
+    scales[g] = (unsigned char)pick;
+}
