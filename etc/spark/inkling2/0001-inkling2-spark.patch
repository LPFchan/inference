+    /// Every rank's f32 partial rows (`region`: one slot of `rows` rows a rank) summed into BF16 `out`, on `stream`
+    /// (tf_ik_rank_sum's arithmetic). Prompt passes over two ranks split the rows: each rank sends the peer the f32
+    /// rows the peer sums, sums its own half in rank order, and the BF16 halves gather: 3/4 of the all-gather's bytes.
+    /// `out` takes rows + 1 rows (an odd count pads its second half).
+    pub fn exchangeSum(f: *Forward, stream: cuda.Stream, region: u64, rows: usize, out: u64) !void {
+        const share = f.w.share;
+        const h: usize = cfg.hidden;
+        const e = f.exchange orelse return f.gatherSum(stream, region, rows, out);
+        if (share.world != 2 or rows < kern.prompt_tile_rows or f.graphing) return f.gatherSum(stream, region, rows, out);
+        const half = (rows + 1) / 2;
+        const rank = share.rank;
