 zig/kernels/cuda/inkling2_residual.cuh | 125 ++++++++++++++++++-------
 zig/src/families/inkling2/draft.zig    |   4 +-
 zig/src/families/inkling2/forward.zig  |  10 +-
 zig/src/families/inkling2/fp4.zig      |   8 +-
 zig/src/families/inkling2/kernels.zig  |   8 ++
 zig/src/families/inkling2/native.zig   |   2 +-
 7 files changed, 189 insertions(+), 90 deletions(-)

