+                for (int n = 0; n < KW / 8; ++n) ik_mma(sc[mt][n], qf, kb[n][0], kb[n][1]);
+            }
+        }
+#pragma unroll
+        for (int mt = 0; mt < MT; ++mt)
+#pragma unroll
+            for (int n = 0; n < KW / 8; ++n)
+#pragma unroll
+                for (int half = 0; half < 2; ++half)
+#pragma unroll
+                    for (int e = 0; e < 2; ++e) {
+                        const int row = rrow[mt][half], col = w * KW + n * 8 + 2 * sub + e;
+                        const int distance = a.pos + row - (base + col);
+                        float score = sc[mt][n][2 * half + e] * 0.08838834764831845f;
+                        const bool valid = rok[mt][half] && distance >= 0 && (!a.window || distance <= a.window);
+                        if (valid && distance < 1024) score += f(a.relative[((size_t)row * a.hq + rhead[mt][half]) * 1024 + distance]);
+                        sh.scores[mt * 16 + g + half * 8][col] = valid ? score : -INFINITY;
+                    }
+        __syncthreads();
+        unsigned bad = 0;
+#pragma unroll
+        for (int pass = 0; pass < (MT * 16 + RP - 1) / RP; ++pass) {
+            const int row = pass * RP + t / 8, rr = min(row, MT * 16 - 1), col0 = t % 8; // rows past the tiles: no writes
+            float m = sh.maxima[rr];
+            for (int col = col0; col < NK; col += 8) {
+                const float v = sh.scores[rr][col];
+                m = isnan(m) || isnan(v) ? nanf("") : fmaxf(m, v);
+            }
+            for (int off = 1; off < 8; off <<= 1) {
+                const float other = __shfl_xor_sync(0xffffffffu, m, off, 8);
+                m = isnan(m) || isnan(other) ? nanf("") : fmaxf(m, other);
+            }
+            const float aold = sh.maxima[rr] == m ? 1.f : expf(sh.maxima[rr] - m);
+            float z = 0.f;
+            bool exceptional = false;
+            for (int col = col0; col < NK; col += 8) {
+                float p = sh.scores[rr][col] == -INFINITY ? 0.f : expf(sh.scores[rr][col] - m);
+                z += p;
+                for (int limb = 0; limb < 3; ++limb) {
+                    const bf16 piece = b(p);
+                    if (row == rr) sh.probabilities[limb][rr][col] = piece;
+                    exceptional |= f(piece) != 0.f && fabsf(f(piece)) < 0x1p-126f;
+                    p -= f(piece);
+                }
+                exceptional |= p != 0.f;
+            }
+            if (exceptional) bad |= 1u << (rr % G);
+            for (int off = 1; off < 8; off <<= 1) z += __shfl_xor_sync(0xffffffffu, z, off, 8);
+            if (!col0 && row == rr) { sh.totals[rr] = sh.totals[rr] * aold + z; sh.maxima[rr] = m; sh.alpha[rr] = aold; }
+        }
+        if (bad) atomicOr(&sh.bad, bad);
+        __syncthreads();
+#pragma unroll
+        for (int mt = 0; mt < MT; ++mt)
+#pragma unroll
+            for (int n = 0; n < CW / 8; ++n)
+#pragma unroll
+                for (int e = 0; e < 4; ++e) out[mt][n][e] *= sh.alpha[mt * 16 + g + (e / 2) * 8];
+#pragma unroll
+        for (int s = 0; s < 4; ++s) {
+            uint32_t vb[CW / 8][2];
+#pragma unroll
+            for (int n = 0; n < CW / 8; ++n) ik_ldmatrix_t(vb[n][0], vb[n][1], &sh.values[s * 16 + (lane & 15)][w * CW + n * 8]);
+#pragma unroll
+            for (int mt = 0; mt < MT; ++mt)
+#pragma unroll
+                for (int limb = 0; limb < 3; ++limb) {
+                    uint32_t p[4];
+                    p[0] = *reinterpret_cast<const uint32_t*>(&sh.probabilities[limb][mt * 16 + g][s * 16 + 2 * sub]);
+                    p[1] = *reinterpret_cast<const uint32_t*>(&sh.probabilities[limb][mt * 16 + g + 8][s * 16 + 2 * sub]);
+                    p[2] = *reinterpret_cast<const uint32_t*>(&sh.probabilities[limb][mt * 16 + g][s * 16 + 8 + 2 * sub]);
+                    p[3] = *reinterpret_cast<const uint32_t*>(&sh.probabilities[limb][mt * 16 + g + 8][s * 16 + 8 + 2 * sub]);
+#pragma unroll
+                    for (int n = 0; n < CW / 8; ++n) ik_mma(out[mt][n], p, vb[n][0], vb[n][1]);
+                }
+        }
+        __syncthreads();
+    }
+    // the partials of row r, query head h at the slot tf_ik_attention_part writes them to
+#pragma unroll
+    for (int mt = 0; mt < MT; ++mt)
+#pragma unroll
+        for (int n = 0; n < CW / 8; ++n)
+#pragma unroll
+            for (int half = 0; half < 2; ++half)
+#pragma unroll
+                for (int e = 0; e < 2; ++e) {
+                    if (!rok[mt][half]) continue;
+                    const int c = w * CW + n * 8 + 2 * sub + e;
+                    parts[((size_t)(j * a.hq + rhead[mt][half]) * 16 + rrow[mt][half]) * IK_SLOT + c] = out[mt][n][half * 2 + e];
+                }
+    for (int m = t; m < M; m += NT) {
+        float* slot = parts + ((size_t)(j * a.hq + kh * G + m % G) * 16 + m / G) * IK_SLOT;
+        slot[128] = sh.maxima[m];
+        slot[129] = sh.totals[m];
+    }
+    if (t < G) parts[(size_t)(j * a.hq + kh * G + t) * 16 * IK_SLOT + 130] = (sh.bad >> t) & 1u ? 1.f : 0.f;
+}
+
+// one tile (up to 16 / G rows): 4 warps, two CTAs an SM; two and three tiles: 8 warps, one CTA an SM
+extern "C" __global__ __launch_bounds__(128, 2) void tf_ik_attention_part4(InklingAttention a, float* parts) { ik_attention_part4<1, 4>(a, parts); }
+extern "C" __global__ __launch_bounds__(256) void tf_ik_attention_part4_2(InklingAttention a, float* parts) { ik_attention_part4<2, 8>(a, parts); }
+extern "C" __global__ __launch_bounds__(256) void tf_ik_attention_part4_3(InklingAttention a, float* parts) { ik_attention_part4<3, 8>(a, parts); }
+
+// tf_ik_attention_merge over `splits` partials (tf_ik_attention_part4's gridDim.y).
+extern "C" __global__ __launch_bounds__(128) void tf_ik_attention_merge4(InklingAttention a, const float* parts, int splits) {
+    ik_attention_merge<IK_MAX_SPLITS>(a, parts, splits);
+}
