@@ -0,0 +1,327 @@
+//! A request's images on both ranks (--vision): the server's HTTP thread cuts each into the tower's patches
+//! (`prepare`), rank 0's tower encodes them before the prompt pass that reaches them, the peer receives the rows, and
+//! both ranks write them over the image's placeholder rows once the prompt's embeddings are normed (Forward.body):
+//! SGLang feeds the tower's rows to the first layer as they are, without the text embeddings' norm.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const lanes = @import("lanes");
+const cfg = @import("config.zig");
+const vision = @import("vision.zig");
+const picture = core.picture;
+
+/// What a request may hold: image tokens in all (the rows buffer, and the tower's largest image), and images.
+pub const Limits = struct { image_tokens: u32, max_images: u32 };
+
+/// The most images a request may hold (--vision-max-images): their spans ride in one record to the peer.
+pub const max_images = 64;
+
+/// Prompt rows [at, at + n) take image rows [row, row + n).
+pub const Span = struct { at: u32, n: u32, row: u32 };
+
+/// One image as the tower takes it: its patches ([gh gw, vision.patch_in], raster order), patch grid, tokens, identity.
+pub const Prepared = struct { pixels: []f32, gh: u32, gw: u32, tokens: u32, hash: u64 };
+
+/// The template's tokens around an image: `<|content_image|><|unused_200054|><|end_message|>`.
+pub const content_image: u32 = 200005;
+pub const image_token: u32 = 200054;
+pub const end_message: u32 = 200010;
+
+pub const Images = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    d: *const cuda.Driver,
+    module: cuda.Module,
+    f: vision.Funcs,
+    tower: ?vision.Tower = null, // rank 0's; the peer receives the rows
+    rows: cuda.DeviceBuffer, // bf16 [limits.image_tokens, hidden]
+    map: cuda.DeviceBuffer, // i32 [prompt rows]: a pass's image row a prompt row (-1: its own)
+    host_map: []i32,
+    limits: Limits,
+    spans: std.ArrayList(Span) = .empty,
+    owner: ?usize = null, // the slot whose images the rows hold
+    dump: ?[]const u8 = null, // TF_INKLING_VISION_DUMP: rank 0 writes each image's rows there (checks)
+    dumped: usize = 0,
+    marks: struct { image: u32, open: u32, close: u32 } = .{ .image = image_token, .open = content_image, .close = end_message },
+    mark_ids: [3]u32 = .{ content_image, image_token, end_message },
+
+    /// The chat template writes each image's begin and end itself: the server expands the image token alone.
+    pub const template_wraps = true;
+
+    /// The rows and the map on every rank, and with `tower` (rank 0: TF_INKLING_VISION's file) the tower.
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, limits: Limits, prompt_rows: usize, tower: ?[]const u8, lt: *const cuda.cublaslt.Library, ws: u64, ws_len: usize) !*Images {
+        if (limits.image_tokens == 0 or limits.max_images == 0 or limits.max_images > max_images) return error.InklingImageRows;
+        const v = try gpa.create(Images);
+        errdefer gpa.destroy(v);
+        var module = try cuda.Module.load(d, cuda.kernels.inkling2_vision);
+        errdefer module.unload();
+        v.* = .{ .gpa = gpa, .io = io, .d = d, .module = module, .f = try vision.Funcs.load(module), .rows = undefined, .map = undefined, .host_map = undefined, .limits = limits };
+        v.rows = try cuda.DeviceBuffer.alloc(d, @as(usize, limits.image_tokens) * cfg.hidden * 2);
+        errdefer v.rows.free();
+        v.map = try cuda.DeviceBuffer.alloc(d, prompt_rows * 4);
+        errdefer v.map.free();
+        v.host_map = try gpa.alloc(i32, prompt_rows);
+        errdefer gpa.free(v.host_map);
+        try v.spans.ensureTotalCapacity(gpa, limits.max_images);
+        errdefer v.spans.deinit(gpa);
+        const sys = @import("sys");
+        v.dump = sys.environment.path("TF_INKLING_VISION_DUMP", sys.getenv("TF_INKLING_VISION_DUMP")) catch return error.InvalidEnvironment;
+        if (tower) |path| v.tower = try vision.Tower.load(gpa, io, d, lt, ws, ws_len, v.f, path, limits.image_tokens);
+        return v;
+    }
+
+    pub fn deinit(v: *Images) void {
+        if (v.tower) |*t| t.deinit();
+        v.spans.deinit(v.gpa);
+        v.gpa.free(v.host_map);
+        v.map.free();
+        v.rows.free();
+        v.module.unload();
+        v.gpa.destroy(v);
+    }
+
+    /// Device bytes: the tower and the buffers.
+    pub fn bytes(v: *const Images) usize {
+        return (if (v.tower) |*t| t.bytes() else 0) + v.rows.len + v.map.len;
+    }
+
+    /// Info.vision's prepare, on the server's thread: the image's bytes at most `max_tokens` tiles of 40 pixels.
+    pub fn prepare(v: *Images, a: std.mem.Allocator, data: []const u8, max_tokens: u32) !Prepared {
+        return prepareBytes(v.io, a, data, max_tokens);
+    }
+
+    /// The words for the decoder's refusals the server cannot word.
+    pub fn explain(err: anyerror) ?[]const u8 {
+        return picture.decoderProblem(err);
+    }
+
+    /// The images of `imgs` ending past `from` that a pass from there still embeds.
+    pub fn after(imgs: []const lanes.stream.Image, from: usize) []const lanes.stream.Image {
+        for (imgs, 0..) |img, k| if (@as(usize, img.at) + img.tokens > from) return imgs[k..];
+        return imgs[imgs.len..];
+    }
+
+    /// Whether slot `lane`'s next pass from `from` needs its images through the tower first.
+    pub fn needs(v: *const Images, lane: usize, imgs: []const lanes.stream.Image, from: usize) bool {
+        return after(imgs, from).len > 0 and v.owner != lane;
+    }
+
+    /// Rank 0: `imgs` (in prompt order) ending past `from` through the tower into the rows, for slot `lane`.
+    pub fn encode(v: *Images, s: cuda.Stream, lane: usize, imgs: []const lanes.stream.Image, from: usize) !void {
+        v.owner = null;
+        v.spans.clearRetainingCapacity();
+        const t = &(v.tower orelse return error.InklingTextOnly);
+        var row: u32 = 0;
+        for (after(imgs, from)) |img| {
+            if (img.gh * img.gw != img.tokens * 4) return error.InklingImageGrid;
+            if (img.tokens > v.limits.image_tokens - row or v.spans.items.len == v.limits.max_images) return error.InklingImageRows;
+            try t.encode(s, img.pixels, img.gh, img.gw, v.rows.ptr + @as(u64, row) * cfg.hidden * 2);
+            v.spans.appendAssumeCapacity(.{ .at = img.at, .n = img.tokens, .row = row });
+            if (v.dump) |dir| try v.write(dir, row, img.tokens);
+            row += img.tokens;
+        }
+        v.owner = lane;
+    }
+
+    fn write(v: *Images, dir: []const u8, row: u32, n: u32) !void {
+        const host = try v.gpa.alloc(u8, @as(usize, n) * cfg.hidden * 2);
+        defer v.gpa.free(host);
+        try v.rows.download(@as(usize, row) * cfg.hidden * 2, host);
+        var name: [512]u8 = undefined;
+        const path = try std.fmt.bufPrint(&name, "{s}/image-{d}.bin", .{ dir, v.dumped });
+        try std.Io.Dir.cwd().writeFile(v.io, .{ .sub_path = path, .data = host });
+        std.log.info("inkling vision: image {d}'s {d} rows written to {s}", .{ v.dumped, n, path });
+        v.dumped += 1;
+    }
+
+    /// The spans as the peer's record carries them: at, n, row each.
+    pub fn words(v: *const Images, out: []u32) []u32 {
+        for (v.spans.items, 0..) |sp, i| out[3 * i ..][0..3].* = .{ sp.at, sp.n, sp.row };
+        return out[0 .. 3 * v.spans.items.len];
+    }
+
+    /// The peer: rank 0's spans (`words`) for slot `lane`; their rows arrive into `rows` next.
+    pub fn take(v: *Images, lane: usize, w: []const u32) !void {
+        v.owner = null;
+        v.spans.clearRetainingCapacity();
+        if (w.len % 3 != 0 or w.len / 3 > v.limits.max_images) return error.InklingCommand;
+        var i: usize = 0;
+        while (i < w.len) : (i += 3) {
+            const sp: Span = .{ .at = w[i], .n = w[i + 1], .row = w[i + 2] };
+            if (sp.row > v.limits.image_tokens or sp.n > v.limits.image_tokens - sp.row) return error.InklingCommand;
+            v.spans.appendAssumeCapacity(sp);
+        }
+        v.owner = lane;
+    }
+
+    /// The bytes of the rows the spans hold (what crosses to the peer).
+    pub fn heldBytes(v: *const Images) usize {
+        var n: usize = 0;
+        for (v.spans.items) |sp| n = @max(n, sp.row + sp.n);
+        return n * cfg.hidden * 2;
+    }
+
+    /// Slot `lane`'s request ended or another began on it: no pass takes these rows again.
+    pub fn drop(v: *Images, lane: usize) void {
+        if (v.owner != lane) return;
+        v.owner = null;
+        v.spans.clearRetainingCapacity();
+    }
+
+    /// Whether slot `lane`'s rows [pos, pos + rows) cross an image.
+    pub fn covers(v: *const Images, lane: usize, pos: usize, rows: usize) bool {
+        if (v.owner != lane) return false;
+        for (v.spans.items) |sp| if (sp.at < pos + rows and pos < @as(usize, sp.at) + sp.n) return true;
+        return false;
+    }
+
+    /// Slot `lane`'s prompt rows [pos, pos + rows), normed at `dst` (bf16 [rows, hidden]), take the image rows they cross.
+    pub fn splice(v: *Images, s: cuda.Stream, lane: usize, pos: usize, rows: usize, dst: u64) !void {
+        if (!v.covers(lane, pos, rows)) return;
+        if (rows > v.host_map.len) return error.InklingContext;
+        const m = v.host_map[0..rows];
+        @memset(m, -1);
+        for (v.spans.items) |sp| {
+            const lo = @max(pos, sp.at);
+            const hi = @min(pos + rows, @as(usize, sp.at) + sp.n);
+            var p = lo;
+            while (p < hi) : (p += 1) m[p - pos] = @intCast(sp.row + (p - sp.at));
+        }
+        try cuda.copy_source.enqueue(v.d, v.map.ptr, std.mem.sliceAsBytes(m), s);
+        var a: cuda.Args = .{};
+        inline for (.{ v.rows.ptr, dst, v.map.ptr, @as(i32, cfg.hidden) }) |x| a.add(x);
+        try cuda.launch.launch(v.f.inject, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 256 } }, s, &a);
+    }
+};
+
+/// The size of the same shape whose 40-pixel tiles fit `max_tokens`: the image's own when it fits.
+pub fn fit(width: usize, height: usize, max_tokens: u32) error{ImageTooSmall}![2]usize {
+    if (max_tokens == 0) return error.ImageTooSmall;
+    if (tiles(width, height) <= max_tokens) return .{ width, height };
+    const w: f64 = @floatFromInt(width);
+    const h: f64 = @floatFromInt(height);
+    var s = @sqrt(@as(f64, @floatFromInt(max_tokens)) * vision.tile * vision.tile / (w * h));
+    while (true) : (s *= 0.99) {
+        const tw: usize = @max(1, @as(usize, @intFromFloat(@floor(w * s))));
+        const th: usize = @max(1, @as(usize, @intFromFloat(@floor(h * s))));
+        if (tiles(tw, th) <= max_tokens) return .{ tw, th };
+    }
+}
+
+fn tiles(width: usize, height: usize) usize {
+    return ((width + vision.tile - 1) / vision.tile) * ((height + vision.tile - 1) / vision.tile);
+}
+
+// The processor's CLIP normalization (float32), then the tower's own back to [-1, 1] (its bf16 constants).
+const mean = [3]f32{ 0.48145466, 0.4578275, 0.40821073 };
+const sd = [3]f32{ 0.26862954, 0.2613026, 0.2757771 };
+const clip_mean = [3]f32{ 0.48145466, 0.4578275, 0.40821073 };
+const clip_sd = [3]f32{ 0.26862954, 0.26130258, 0.27577711 };
+
+fn round(x: f32) f32 {
+    return @bitCast(@as(u32, vision.bf16(x)) << 16);
+}
+
+/// The tower's input for a channel value (-1: the padding): bf16((v / 255 - mean) / sd), then bf16(2 (x sd + mean) - 1).
+pub fn level(c: usize, v: f32) f32 {
+    const n = round((v / 255.0 - mean[c]) / sd[c]);
+    return round(2.0 * (n * round(clip_sd[c]) + round(clip_mean[c])) - 1.0);
+}
+
+/// Bytes to the tower's patches: decoded, EXIF-oriented, alpha over the 8-pixel checkerboard, shrunk (bicubic) only
+/// when its tiles exceed `max_tokens`, padded to whole tiles with -1 and normalized; one token a 40x40 tile.
+pub fn prepareBytes(io: std.Io, a: std.mem.Allocator, data: []const u8, max_tokens: u32) !Prepared {
+    var img = try decode(io, a, data);
+    defer img.deinit(a);
+    const size = try fit(img.width, img.height, max_tokens);
+    var pixels = img.pixels;
+    var resized: ?[]u8 = null;
+    defer if (resized) |r| a.free(r);
+    if (size[0] != img.width or size[1] != img.height) {
+        resized = try picture.resample.resize(a, .pillow, .of(img.pixels, img.width, img.height), size[0], size[1]);
+        pixels = resized.?;
+    }
+    const w = size[0];
+    const h = size[1];
+    const gh = 2 * ((h + vision.tile - 1) / vision.tile);
+    const gw = 2 * ((w + vision.tile - 1) / vision.tile);
+    var lut: [3][257]f32 = undefined;
+    for (0..3) |c| {
+        for (0..256) |v| lut[c][v] = level(c, @floatFromInt(v));
+        lut[c][256] = level(c, -1);
+    }
+    const out = try a.alloc(f32, gh * gw * vision.patch_in);
+    errdefer a.free(out);
+    const P = vision.patch;
+    for (0..gh) |py0| for (0..gw) |px0| {
+        const dst = out[(py0 * gw + px0) * vision.patch_in ..][0..vision.patch_in];
+        for (0..P) |dy| for (0..P) |dx| {
+            const y = py0 * P + dy;
+            const x = px0 * P + dx;
+            for (0..3) |c| dst[(dy * P + dx) * 3 + c] = if (y < h and x < w) lut[c][pixels[(y * w + x) * 3 + c]] else lut[c][256];
+        };
+    };
+    const grid = [2]u32{ @intCast(gh), @intCast(gw) };
+    return .{ .pixels = out, .gh = grid[0], .gw = grid[1], .tokens = grid[0] * grid[1] / 4, .hash = picture.identity.withGrid(picture.identity.ofBytes(0x1c2b, data), grid) };
+}
+
+/// PNG, JPEG or WebP bytes to oriented RGB; transparency over Inkling's checkerboard (204 and 153, 8-pixel squares).
+fn decode(io: std.Io, a: std.mem.Allocator, data: []const u8) picture.Error!picture.Rgb {
+    const s = switch (picture.sniff(data)) {
+        .png => try picture.png.decodeWithLimits(a, data, .{}),
+        .jpeg => try picture.jpeg.decodeWithLimits(io, a, data, .{}),
+        .webp => try picture.webp.decodeWithLimits(io, a, data, .{}),
+        .unknown => return error.Invalid,
+    };
+    defer a.free(s.data);
+    if (s.channels != 4) return picture.finish(a, s); // opaque: its orientation alone
+    const o = if (s.orientation >= 2 and s.orientation <= 8) s.orientation else 1;
+    const turned = o >= 5;
+    const w, const h = if (turned) .{ s.height, s.width } else .{ s.width, s.height };
+    const out = try a.alloc(u8, w * h * 3);
+    for (0..h) |y| for (0..w) |x| {
+        const sx, const sy = switch (o) {
+            2 => .{ s.width - 1 - x, y },
+            3 => .{ s.width - 1 - x, s.height - 1 - y },
+            4 => .{ x, s.height - 1 - y },
+            5 => .{ y, x },
+            6 => .{ y, s.height - 1 - x },
+            7 => .{ s.width - 1 - y, s.height - 1 - x },
+            8 => .{ s.width - 1 - y, x },
+            else => .{ x, y },
+        };
+        const px = s.data[(sy * s.width + sx) * 4 ..][0..4];
+        const bg: u32 = if ((x / 8 + y / 8) % 2 == 0) 204 else 153;
+        for (out[(y * w + x) * 3 ..][0..3], px[0..3]) |*c, v| c.* = @intCast((@as(u32, v) * px[3] + bg * (255 - @as(u32, px[3])) + 127) / 255);
+    };
+    return .{ .width = w, .height = h, .pixels = out };
+}
+
+test "an image keeps its size while its tiles fit, else shrinks to the largest that fits" {
+    try std.testing.expectEqual([2]usize{ 1920, 1080 }, try fit(1920, 1080, 4096));
+    const s = try fit(4032, 3024, 4096);
+    try std.testing.expect(tiles(s[0], s[1]) <= 4096 and tiles(s[0], s[1]) > 3900);
+    try std.testing.expectEqual([2]usize{ 1, 1 }, try fit(1, 1, 1));
+    try std.testing.expectError(error.ImageTooSmall, fit(10, 10, 0));
+}
+
+test "the tower's input levels: white near 1, black near -1, the padding just under -1" {
+    try std.testing.expect(@abs(level(0, 255) - 1.0) < 0.01);
+    try std.testing.expect(@abs(level(1, 0) + 1.0) < 0.01);
+    try std.testing.expect(level(2, -1) < -1.0);
+}
+
+test "a span's rows land on the prompt rows it covers, in any pass that crosses it" {
+    var map: [8]i32 = undefined;
+    var v: Images = undefined;
+    v.spans = .empty;
+    try v.spans.append(std.testing.allocator, .{ .at = 5, .n = 6, .row = 0 });
+    defer v.spans.deinit(std.testing.allocator);
+    v.owner = 1;
+    v.host_map = &map;
+    try std.testing.expect(v.covers(1, 0, 8) and v.covers(1, 10, 4) and !v.covers(1, 11, 4) and !v.covers(0, 0, 8) and !v.covers(1, 0, 5));
+    v.drop(0);
+    try std.testing.expect(v.owner == 1);
+    v.drop(1);
+    try std.testing.expect(v.owner == null and v.spans.items.len == 0);
+}
