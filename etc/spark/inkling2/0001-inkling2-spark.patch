new file mode 100644
index 00000000..74436327
--- /dev/null
+++ b/zig/src/families/inkling2/pool.zig
@@ -0,0 +1,287 @@
+//! The global caches' shared pool (TF_INKLING_STREAMS): one buffer per global cache (the target's eight layers' K and V
+//! and the drafter's global layer's), each stream's region the same token interval [start, start + capacity) in every
+//! one, a ring of its own capacity in the cache's layout (inkling2_kv4.cuh; BF16: position-major rows), so every kernel
+//! reads it as it reads a whole cache. Rank 0 places regions here; each placement is a list of `Move`s both ranks run.
+const std = @import("std");
+
+/// Regions start and end on these many positions.
+pub const unit = 256;
+pub const most = 16; // regions at once: every stream's and every kept turn's, with room to spare
+pub const none: u32 = std.math.maxInt(u32);
+
+pub const Region = struct { start: usize = 0, capacity: usize = 0 };
+
+/// Copy positions [0, count) of `src` into `dst` (another capacity's layout, maybe overlapping it), then bind `lane`
+/// (none: no stream) to `dst`. count 0 copies nothing.
+pub const Move = struct { src: Region, dst: Region, count: usize, lane: u32 };
+
+pub const Moves = struct {
+    list: [most + 2]Move = undefined,
+    n: usize = 0,
+    fn add(m: *Moves, x: Move) void {
+        m.list[m.n] = x;
+        m.n += 1;
+    }
+    pub fn items(m: *const Moves) []const Move {
+        return m.list[0..m.n];
+    }
+};
+
+const Held = struct {
+    id: u32,
+    region: Region,
+    lane: u32 = none, // the stream writing it
+    refs: u32 = 0, // the kept turns that read it, a bit each
+    used: u64 = 0, // last bound or kept: the oldest idle one goes first
+};
+
+/// What `place` did: the region's id, and the kept turns whose regions it evicted (their bits).
+pub const Placed = struct { id: u32, dropped: u32 = 0, adopted: bool = false };
+
+/// Rank 0's map of the pool: who holds which interval.
+pub const Map = struct {
+    tokens: usize,
+    held: [most]Held = undefined,
+    n: usize = 0,
+    next_id: u32 = 1,
+    clock: u64 = 0,
+
+    fn find(m: *const Map, id: u32) ?usize {
+        for (m.held[0..m.n], 0..) |h, i| if (h.id == id) return i;
+        return null;
+    }
+    pub fn region(m: *const Map, id: u32) ?Region {
+        return if (m.find(id)) |i| m.held[i].region else null;
+    }
+    pub fn laneRegion(m: *const Map, lane: u32) ?u32 {
+        for (m.held[0..m.n]) |h| if (h.lane == lane) return h.id;
+        return null;
+    }
+    fn remove(m: *Map, i: usize) void {
+        std.mem.copyForwards(Held, m.held[i .. m.n - 1], m.held[i + 1 .. m.n]);
+        m.n -= 1;
+    }
+    /// Sorted by start: regions are kept in address order.
+    fn insert(m: *Map, h: Held) void {
+        var i: usize = 0;
+        while (i < m.n and m.held[i].region.start < h.region.start) i += 1;
+        std.mem.copyBackwards(Held, m.held[i + 1 .. m.n + 1], m.held[i..m.n]);
+        m.held[i] = h;
+        m.n += 1;
+    }
+    fn gapAfter(m: *const Map, i: usize) usize {
+        const end = m.held[i].region.start + m.held[i].region.capacity;
+        const next = if (i + 1 < m.n) m.held[i + 1].region.start else m.tokens;
+        return next - end;
+    }
+    fn firstFit(m: *const Map, capacity: usize) ?usize {
+        var at: usize = 0;
+        for (m.held[0..m.n]) |h| {
+            if (h.region.start - at >= capacity) return at;
+            at = h.region.start + h.region.capacity;
+        }
+        return if (m.tokens - at >= capacity) at else null;
+    }
+    fn used(m: *const Map) usize {
+        var n: usize = 0;
+        for (m.held[0..m.n]) |h| n += h.region.capacity;
+        return n;
+    }
+
+    /// Whether `capacity` fits once every idle region but `source` (an id, 0: none) is evicted.
+    pub fn fits(m: *const Map, capacity: usize, source: u32) bool {
+        var busy: usize = 0;
+        for (m.held[0..m.n]) |h| {
+            if (h.lane != none or h.id == source) busy += h.region.capacity;
+        }
+        return capacity <= m.tokens and busy + capacity <= m.tokens and m.n < most;
+    }
+
+    /// A region of `capacity` positions bound to `lane`; with `from` (a region id and a position), its rows before that
+    /// position come along: an idle region big enough (or with room behind it) is taken over, else copied out. Idle
+    /// regions go oldest first, then everything slides down; LaneMemory (nothing changed) when it cannot fit yet.
+    pub fn place(m: *Map, lane: u32, capacity: usize, from: ?struct { id: u32, at: usize }, out: *Moves) error{LaneMemory}!Placed {
+        const source: u32 = if (from) |f| f.id else 0;
+        m.clock += 1;
+        if (from) |f| if (m.find(f.id)) |i| if (m.held[i].lane == none) {
+            const r = m.held[i].region;
+            if (r.capacity >= capacity or r.capacity + m.gapAfter(i) >= capacity) {
+                const grown: Region = .{ .start = r.start, .capacity = @max(r.capacity, capacity) };
+                out.add(.{ .src = r, .dst = grown, .count = if (grown.capacity == r.capacity) 0 else f.at, .lane = lane });
+                m.held[i].region = grown;
+                m.held[i].lane = lane;
+                m.held[i].used = m.clock;
+                return .{ .id = f.id, .adopted = true };
+            }
+        };
+        if (!m.fits(capacity, source)) return error.LaneMemory;
+        var placed: Placed = .{ .id = 0 };
+        var start = m.firstFit(capacity);
+        while (start == null) {
+            // the oldest idle region but the source goes; with none left, compaction makes the room
+            var oldest: ?usize = null;
+            for (m.held[0..m.n], 0..) |h, i| {
+                if (h.lane != none or h.id == source) continue;
+                if (oldest == null or h.used < m.held[oldest.?].used) oldest = i;
+            }
+            if (oldest) |i| {
+                placed.dropped |= m.held[i].refs;
+                m.remove(i);
+                start = m.firstFit(capacity);
+                continue;
+            }
+            var at: usize = 0;
+            for (m.held[0..m.n]) |*h| {
+                if (h.region.start != at) {
+                    const moved: Region = .{ .start = at, .capacity = h.region.capacity };
+                    out.add(.{ .src = h.region, .dst = moved, .count = h.region.capacity, .lane = h.lane });
+                    h.region = moved;
+                }
+                at += h.region.capacity;
+            }
+            start = m.firstFit(capacity);
+            std.debug.assert(start != null);
+        }
+        const dst: Region = .{ .start = start.?, .capacity = capacity };
+        const id = m.next_id;
+        m.next_id += 1;
+        const src: ?Region = if (from) |f| m.region(f.id) else null;
+        out.add(.{ .src = src orelse dst, .dst = dst, .count = if (src != null) from.?.at else 0, .lane = lane });
+        m.insert(.{ .id = id, .region = dst, .lane = lane, .used = m.clock });
+        placed.id = id;
+        return placed;
+    }
+
+    /// The stream left: its region stays for the turns kept on it, until they go or the room is needed.
+    pub fn release(m: *Map, lane: u32) void {
+        for (m.held[0..m.n], 0..) |*h, i| if (h.lane == lane) {
+            h.lane = none;
+            if (h.refs == 0) m.remove(i);
+            return;
+        };
+    }
+
+    /// Kept turn `bit` now reads region `id` (0: none).
+    pub fn keep(m: *Map, bit: u5, id: u32) void {
+        const mask = @as(u32, 1) << bit;
+        var i: usize = 0;
+        while (i < m.n) {
+            const h = &m.held[i];
+            if (h.id == id) {
+                h.refs |= mask;
+                h.used = m.clock;
+            } else if (h.refs & mask != 0) {
+                h.refs &= ~mask;
+                if (h.refs == 0 and h.lane == none) {
+                    m.remove(i);
+                    continue;
+                }
+            }
+            i += 1;
+        }
+    }
+
+    /// Positions free now (nothing evicted).
+    pub fn free(m: *const Map) usize {
+        return m.tokens - m.used();
+    }
+};
+
+/// One copy of a move's rows in one buffer: `len` bytes from `src` to `dst` (offsets from the buffer's base).
+pub const Piece = struct { src: usize, dst: usize, len: usize };
+
+/// The pieces of a move in a buffer whose rows take `row` bytes a position (`heads` heads; FP4: per head 64 code bytes
+/// a position, then 8 scale bytes a position, inkling2_kv4.cuh), in layout order.
+pub fn pieces(mv: Move, row: usize, heads: usize, fp4: bool, out: *[16]Piece) []const Piece {
+    const s = mv.src;
+    const d = mv.dst;
+    if (!fp4) {
+        out[0] = .{ .src = s.start * row, .dst = d.start * row, .len = mv.count * row };
+        return out[0..1];
+    }
+    for (0..heads) |h| {
+        out[h] = .{ .src = s.start * row + h * s.capacity * 64, .dst = d.start * row + h * d.capacity * 64, .len = mv.count * 64 };
+        out[heads + h] = .{ .src = s.start * row + heads * s.capacity * 64 + h * s.capacity * 8, .dst = d.start * row + heads * d.capacity * 64 + h * d.capacity * 8, .len = mv.count * 8 };
+    }
+    return out[0 .. 2 * heads];
+}
+
+test "regions fit first, idle ones go oldest first, and the rest slide down when the room is in holes" {
+    var m: Map = .{ .tokens = 10 * unit };
+    var moves: Moves = .{};
+    const a = try m.place(0, 3 * unit, null, &moves);
+    const b = try m.place(1, 3 * unit, null, &moves);
+    const c = try m.place(2, 3 * unit, null, &moves);
+    try std.testing.expectEqual(@as(usize, 3), moves.n);
+    try std.testing.expectEqual(Region{ .start = 3 * unit, .capacity = 3 * unit }, m.region(b.id).?);
+    try std.testing.expectError(error.LaneMemory, m.place(3, 2 * unit, null, &moves));
+    m.release(0); // no turn reads it: gone
+    m.keep(0, c.id); // turn 0 reads lane 2's region
+    m.release(2);
+    try std.testing.expect(m.region(a.id) == null and m.region(c.id) != null);
+    // 4 needed, 3 + 1 free in holes: lane 2's idle region goes (turn 0's bit with it), and the room behind b takes it
+    moves = .{};
+    const d = try m.place(3, 4 * unit, null, &moves);
+    try std.testing.expectEqual(@as(u32, 1), d.dropped);
+    try std.testing.expectEqual(Region{ .start = 6 * unit, .capacity = 4 * unit }, m.region(d.id).?);
+    try std.testing.expect(m.region(c.id) == null);
+}
+
+test "a busy pool compacts: regions slide down in address order, keeping their streams" {
+    var m: Map = .{ .tokens = 8 * unit };
+    var moves: Moves = .{};
+    const a = try m.place(0, 2 * unit, null, &moves);
+    const b = try m.place(1, 2 * unit, null, &moves);
+    const c = try m.place(2, 2 * unit, null, &moves);
+    m.release(1);
+    _ = b;
+    moves = .{};
+    // 4 free (2 at 2..4, 2 at 6..8): c slides from 4 to 2
+    const d = try m.place(3, 4 * unit, null, &moves);
+    try std.testing.expectEqual(@as(usize, 2), moves.n);
+    try std.testing.expectEqual(Move{ .src = .{ .start = 4 * unit, .capacity = 2 * unit }, .dst = .{ .start = 2 * unit, .capacity = 2 * unit }, .count = 2 * unit, .lane = 2 }, moves.list[0]);
+    try std.testing.expectEqual(Region{ .start = 4 * unit, .capacity = 4 * unit }, m.region(d.id).?);
+    try std.testing.expectEqual(Region{ .start = 0, .capacity = 2 * unit }, m.region(a.id).?);
+    try std.testing.expectEqual(@as(?u32, c.id), m.laneRegion(2));
+}
+
+test "a kept turn's region is taken over in place when it is big enough or has room behind it, else copied" {
+    var m: Map = .{ .tokens = 16 * unit };
+    var moves: Moves = .{};
+    const a = try m.place(0, 2 * unit, null, &moves);
+    m.keep(0, a.id);
+    m.release(0);
+    moves = .{};
+    const grown = try m.place(1, 3 * unit, .{ .id = a.id, .at = 300 }, &moves);
+    try std.testing.expect(grown.adopted and grown.id == a.id);
+    try std.testing.expectEqual(Move{ .src = .{ .start = 0, .capacity = 2 * unit }, .dst = .{ .start = 0, .capacity = 3 * unit }, .count = 300, .lane = 1 }, moves.list[0]);
+    const b = try m.place(2, 2 * unit, null, &moves); // right behind it
+    m.release(1);
+    moves = .{};
+    const copied = try m.place(3, 5 * unit, .{ .id = a.id, .at = 700 }, &moves);
