+    __shared__ int claimed[4];
+    bool claiming = true;
+    auto claim = [&](int n) {
+        if (!claiming) return;
+        const int t = atomicAdd(&lean_next, 1u);
+        claimed[n & 3] = t;
+        if (t < tiles) return;
+        claiming = false;
+        if (atomicAdd(&lean_done, 1u) == gridDim.x - 1) atomicExch(&lean_next, 0u), atomicExch(&lean_done, 0u);
