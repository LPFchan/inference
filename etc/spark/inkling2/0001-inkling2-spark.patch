diff --git a/zig/kernels/cuda/inkling2_attention_split.cuh b/zig/kernels/cuda/inkling2_attention_split.cuh
new file mode 100644
index 00000000..6924ab26
--- /dev/null
+++ b/zig/kernels/cuda/inkling2_attention_split.cuh
@@ -0,0 +1,176 @@
+// Decode attention split over keys: CTA (head, j) takes every IK_SPLITS-th 64-key tile, by absolute key position,
+// so a row's partials do not depend on which other rows share the launch; the merge adds them in a fixed order.
+#pragma once
+#include "inkling2_attention_decode.cuh"
+
+#define IK_SPLITS 16
+#define IK_SLOT 132 // out[128], max, total, exceptional flag (row 0), pad
+
+__device__ __forceinline__ void ik_ldmatrix_t(uint32_t& b0, uint32_t& b1, const bf16* p) {
+    const unsigned addr = static_cast<unsigned>(__cvta_generic_to_shared(p));
+    asm volatile("ldmatrix.sync.aligned.m8n8.x2.trans.shared.b16 {%0, %1}, [%2];" : "=r"(b0), "=r"(b1) : "r"(addr));
+}
+
+// Nonzero when any of the eight bf16 is infinite, NaN or subnormal: two halves per instruction.
+__device__ __forceinline__ unsigned ik_unusual8(uint4 x) {
+    unsigned bad = 0;
+    for (const unsigned w : {x.x, x.y, x.z, x.w}) {
+        const unsigned e = w & 0x7f807f80u;
+        bad |= __vcmpeq2(e, 0x7f807f80u) | (__vcmpeq2(e, 0u) & ~__vcmpeq2(w & 0x007f007fu, 0u));
+    }
+    return bad;
+}
+
+extern "C" __global__ __launch_bounds__(128) void tf_ik_attention_part(InklingAttention a, float* parts) {
+    if (a.posp) a.pos = *a.posp;
+    constexpr int D = 128, NK = 64;
+    __shared__ __align__(16) bf16 keys[NK][136], values[NK][136], probabilities[3][16][NK];
+    __shared__ float scores[16][NK], maxima[16], totals[16], alpha[16];
+    const int t = threadIdx.x, w = t >> 5, lane = t & 31, g = lane >> 2, sub = lane & 3;
+    const int head = blockIdx.x, j = blockIdx.y, kh = head / (a.hq / a.hk);
+    const int row0 = g, row1 = g + 8;
+    const int last = a.pos + a.rows - 1;
+    const int first = a.window ? max(0, a.pos - a.window) : 0;
+    float* slot = parts + (size_t)(j * a.hq + head) * 16 * IK_SLOT;
+    bool unusual_q = false;
+    for (int i = t; i < a.rows * D; i += 128) {
+        const float q = f(a.q[((size_t)(i / D) * a.hq + head) * D + i % D]);
+        unusual_q |= !isfinite(q) || (q != 0.f && fabsf(q) < 0x1p-126f);
+    }
+    if (__syncthreads_or(unusual_q)) { if (!t) slot[130] = 1.f; return; }
+    uint32_t qa[8][4];
+    for (int s = 0; s < 8; ++s) {
+        const bf16* q0 = a.q + ((size_t)min(row0, a.rows - 1) * a.hq + head) * D + s * 16;
+        const bf16* q1 = a.q + ((size_t)min(row1, a.rows - 1) * a.hq + head) * D + s * 16;
+        qa[s][0] = *reinterpret_cast<const uint32_t*>(q0 + 2 * sub);
+        qa[s][1] = *reinterpret_cast<const uint32_t*>(q1 + 2 * sub);
+        qa[s][2] = *reinterpret_cast<const uint32_t*>(q0 + 8 + 2 * sub);
+        qa[s][3] = *reinterpret_cast<const uint32_t*>(q1 + 8 + 2 * sub);
+    }
+    float out[4][4] = {};
+    if (t < 16) { maxima[t] = -INFINITY; totals[t] = 0.f; }
+    __syncthreads();
+    const int t0 = first / NK;
+    // the next tile's keys and values wait in registers while this one is computed
+    uint4 kr[8], vr[8];
+    auto fetch = [&](int tile) {
+#pragma unroll
+        for (int r = 0; r < 8; ++r) {
+            const int i = t + r * 128, at = tile * NK + (i >> 4);
+            kr[r] = vr[r] = make_uint4(0, 0, 0, 0);
+            if (at <= last) {
+                const size_t offset = ((size_t)(at % a.capacity) * a.hk + kh) * D + (i & 15) * 8;
+                kr[r] = *reinterpret_cast<const uint4*>(a.k + offset);
+                vr[r] = *reinterpret_cast<const uint4*>(a.v + offset);
+            }
+        }
+    };
+    int tile = t0 + ((j - t0 % IK_SPLITS) + IK_SPLITS) % IK_SPLITS;
+    if (tile * NK <= last) fetch(tile);
+    for (; tile * NK <= last; tile += IK_SPLITS) {
+        const int base = tile * NK;
+        unsigned unusual = 0;
+#pragma unroll
+        for (int r = 0; r < 8; ++r) {
+            const int i = t + r * 128, key = i >> 4, c = (i & 15) * 8;
+            *reinterpret_cast<uint4*>(&keys[key][c]) = kr[r];
+            *reinterpret_cast<uint4*>(&values[key][c]) = vr[r];
+            unusual |= ik_unusual8(kr[r]) | ik_unusual8(vr[r]);
+        }
+        if (__syncthreads_or(unusual != 0)) { if (!t) slot[130] = 1.f; return; }
+        bool exceptional = false;
+        if ((tile + IK_SPLITS) * NK <= last) fetch(tile + IK_SPLITS);
+        float sc[2][4] = {};
+        for (int n = 0; n < 2; ++n) for (int s = 0; s < 8; ++s) {
+            const int key = w * 16 + n * 8 + g;
+            ik_mma(sc[n], qa[s], *reinterpret_cast<const uint32_t*>(&keys[key][s * 16 + 2 * sub]),
+                   *reinterpret_cast<const uint32_t*>(&keys[key][s * 16 + 8 + 2 * sub]));
+        }
+        for (int n = 0; n < 2; ++n) for (int half = 0; half < 2; ++half) for (int e = 0; e < 2; ++e) {
+            const int row = g + half * 8, col = w * 16 + n * 8 + 2 * sub + e;
+            const int distance = a.pos + row - (base + col);
+            float score = sc[n][2 * half + e] * 0.08838834764831845f;
+            const bool valid = row < a.rows && distance >= 0 && (!a.window || distance <= a.window);
+            if (valid && distance < 1024) score += f(a.relative[((size_t)row * a.hq + head) * 1024 + distance]);
+            scores[g + half * 8][col] = valid ? score : -INFINITY;
+        }
+        __syncthreads();
+        const int rr = t / 8, col0 = t % 8;
+        float m = maxima[rr];
+        for (int col = col0; col < NK; col += 8) {
+            const float v = scores[rr][col];
+            m = isnan(m) || isnan(v) ? nanf("") : fmaxf(m, v);
+        }
+        for (int off = 1; off < 8; off <<= 1) {
+            const float other = __shfl_xor_sync(0xffffffffu, m, off, 8);
+            m = isnan(m) || isnan(other) ? nanf("") : fmaxf(m, other);
+        }
+        const float aold = maxima[rr] == m ? 1.f : expf(maxima[rr] - m);
+        float z = 0.f;
+        for (int col = col0; col < NK; col += 8) {
+            float p = scores[rr][col] == -INFINITY ? 0.f : expf(scores[rr][col] - m);
+            z += p;
+            for (int limb = 0; limb < 3; ++limb) {
+                const bf16 piece = b(p);
+                probabilities[limb][rr][col] = piece;
+                exceptional |= f(piece) != 0.f && fabsf(f(piece)) < 0x1p-126f;
+                p -= f(piece);
+            }
+            exceptional |= p != 0.f;
+        }
+        if (__syncthreads_or(exceptional)) { if (!t) slot[130] = 1.f; return; }
+        for (int off = 1; off < 8; off <<= 1) z += __shfl_xor_sync(0xffffffffu, z, off, 8);
+        if (!col0) { totals[rr] = totals[rr] * aold + z; maxima[rr] = m; alpha[rr] = aold; }
+        __syncthreads();
+        for (int n = 0; n < 4; ++n) for (int e = 0; e < 4; ++e) out[n][e] *= alpha[g + (e / 2) * 8];
+        for (int s = 0; s < 4; ++s) {
+            uint32_t vb[4][2];
+            for (int n = 0; n < 4; ++n) ik_ldmatrix_t(vb[n][0], vb[n][1], &values[s * 16 + (lane & 15)][w * 32 + n * 8]);
+            for (int limb = 0; limb < 3; ++limb) {
+                uint32_t p[4];
+                p[0] = *reinterpret_cast<const uint32_t*>(&probabilities[limb][g][s * 16 + 2 * sub]);
+                p[1] = *reinterpret_cast<const uint32_t*>(&probabilities[limb][g + 8][s * 16 + 2 * sub]);
+                p[2] = *reinterpret_cast<const uint32_t*>(&probabilities[limb][g][s * 16 + 8 + 2 * sub]);
+                p[3] = *reinterpret_cast<const uint32_t*>(&probabilities[limb][g + 8][s * 16 + 8 + 2 * sub]);
+                for (int n = 0; n < 4; ++n) ik_mma(out[n], p, vb[n][0], vb[n][1]);
+            }
+        }
+        __syncthreads();
+    }
+    for (int n = 0; n < 4; ++n) for (int half = 0; half < 2; ++half) for (int e = 0; e < 2; ++e) {
+        const int row = g + half * 8, c = w * 32 + n * 8 + 2 * sub + e;
+        if (row < a.rows) slot[row * IK_SLOT + c] = out[n][half * 2 + e];
+    }
+    if (t < a.rows) { slot[t * IK_SLOT + 128] = maxima[t]; slot[t * IK_SLOT + 129] = totals[t]; }
+    if (!t) slot[130] = 0.f;
+}
+
+// One CTA per (head, row): adds the IK_SPLITS partials in order, then the gate and the sink; exceptional inputs take the scalar path.
+extern "C" __global__ __launch_bounds__(128) void tf_ik_attention_merge(InklingAttention a, const float* parts) {
+    if (a.posp) a.pos = *a.posp;
+    __shared__ float top[IK_SPLITS], total[IK_SPLITS];
+    __shared__ int unusual;
+    const int head = blockIdx.x, row = blockIdx.y, c = threadIdx.x;
+    if (row >= a.rows) return;
+    if (!c) unusual = 0;
+    __syncthreads();
+    if (c < IK_SPLITS) {
+        const float* s = parts + ((size_t)(c * a.hq + head) * 16) * IK_SLOT;
+        if (s[130] != 0.f) unusual = 1;
+        top[c] = s[row * IK_SLOT + 128];
+        total[c] = s[row * IK_SLOT + 129];
+    }
+    __syncthreads();
