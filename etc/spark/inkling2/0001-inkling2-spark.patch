diff --git a/zig/kernels/cuda/inkling2_vision.cu b/zig/kernels/cuda/inkling2_vision.cu
new file mode 100644
index 00000000..a90be04b
--- /dev/null
+++ b/zig/kernels/cuda/inkling2_vision.cu
@@ -0,0 +1,156 @@
+// Inkling 2's image tower steps around cuBLASLt (families/inkling2/vision.zig), as SGLang's inkling2_vision.py:
+// a bf16 residual rounded at every add, LayerNorm and GELU in fp32 with one rounding, 2D rotary on q and k in fp32.
+
+#include <cuda_bf16.h>
+#include <stdint.h>
+
+namespace {
+__device__ __forceinline__ float bf(__nv_bfloat16 x) { return __bfloat162float(x); }
+__device__ __forceinline__ __nv_bfloat16 tobf(float x) { return __float2bfloat16_rn(x); }
+__device__ __forceinline__ float rbf(float x) { return bf(tobf(x)); }
+
+// a block's sum (blockDim.x a multiple of 32, at most 1024); every thread gets it
+__device__ float block_sum(float v) {
+    __shared__ float part[32];
+    __shared__ float total;
+    for (int o = 16; o > 0; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o);
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    __syncthreads();
+    if (lane == 0) part[warp] = v;
+    __syncthreads();
+    if (warp == 0) {
+        float s = lane < (int)(blockDim.x >> 5) ? part[lane] : 0.f;
+        for (int o = 16; o > 0; o >>= 1) s += __shfl_xor_sync(0xffffffffu, s, o);
+        if (lane == 0) total = s;
+    }
+    __syncthreads();
+    return total;
+}
+
+__device__ __forceinline__ float gelu(float x) { return 0.5f * x * (1.f + erff(x * 0.70710678118654752f)); }
+
+// one axis of the position grid at an output index: clamp-to-edge linear (align_corners=False), as SGLang's kernel
+__device__ __forceinline__ void axis(int i, int target, int size, int& s0, int& s1, float& w0, float& w1) {
+    float c = __fdiv_rn((float)size * ((float)i + 0.5f), (float)target) - 0.5f;
+    c = fmaxf(0.f, fminf(c, (float)size - 1.f));
+    s0 = (int)floorf(c);
+    s1 = min(s0 + 1, size - 1);
+    w1 = c - (float)s0;
+    w0 = 1.f - w1;
+}
+}  // namespace
+
+// x[1 + r0 + j] = bf16(bf16(acc[j]) + bf16(pos)) for patch rows r0 + j of an H x W grid (row 0 is the class row):
+// the patch embedding's product and the 32 x 32 position grid at the patch, a block a row
+extern "C" __global__ void ikv_embed(const float* __restrict__ acc, const __nv_bfloat16* __restrict__ grid,
+                                     __nv_bfloat16* __restrict__ x, int r0, int H, int W, int width, int size) {
+    const int r = r0 + blockIdx.x;
+    int y0, y1, x0, x1;
+    float wy0, wy1, wx0, wx1;
+    axis(r / W, H, size, y0, y1, wy0, wy1);
+    axis(r % W, W, size, x0, x1, wx0, wx1);
+    const __nv_bfloat16* g00 = grid + (long long)(y0 * size + x0) * width;
+    const __nv_bfloat16* g01 = grid + (long long)(y0 * size + x1) * width;
+    const __nv_bfloat16* g10 = grid + (long long)(y1 * size + x0) * width;
+    const __nv_bfloat16* g11 = grid + (long long)(y1 * size + x1) * width;
+    for (int c = threadIdx.x; c < width; c += blockDim.x) {
+        const float top = bf(g00[c]) * wx0 + bf(g01[c]) * wx1;
+        const float bottom = bf(g10[c]) * wx0 + bf(g11[c]) * wx1;
+        const float pos = rbf(top * wy0 + bottom * wy1);
+        x[(long long)(1 + r) * width + c] = tobf(rbf(acc[(long long)blockIdx.x * width + c]) + pos);
+    }
+}
+
+// x[0] = bf16(class + its position): the class row
+extern "C" __global__ void ikv_cls(const __nv_bfloat16* __restrict__ cls, const __nv_bfloat16* __restrict__ pos,
+                                   __nv_bfloat16* __restrict__ x, int width) {
+    for (int c = threadIdx.x; c < width; c += blockDim.x) x[c] = tobf(bf(cls[c]) + bf(pos[c]));
+}
+
+// LayerNorm of bf16 rows: y = bf16((x - mean) rstd w + b), fp32 statistics, a block a row
+extern "C" __global__ void ikv_ln(const __nv_bfloat16* __restrict__ x, const __nv_bfloat16* __restrict__ w,
+                                  const __nv_bfloat16* __restrict__ b, __nv_bfloat16* __restrict__ y, int cols,
+                                  float eps) {
+    const __nv_bfloat16* row = x + (long long)blockIdx.x * cols;
+    float s = 0.f;
+    for (int c = threadIdx.x; c < cols; c += blockDim.x) s += bf(row[c]);
+    const float mean = block_sum(s) / cols;
+    float v = 0.f;
+    for (int c = threadIdx.x; c < cols; c += blockDim.x) {
+        const float d = bf(row[c]) - mean;
+        v += d * d;
+    }
+    const float inv = rsqrtf(block_sum(v) / cols + eps);
+    for (int c = threadIdx.x; c < cols; c += blockDim.x)
+        y[(long long)blockIdx.x * cols + c] = tobf((bf(row[c]) - mean) * inv * bf(w[c]) + bf(b[c]));
+}
+
+// out = bf16(acc + bias) (bias may be null), then with `act` bf16(gelu(that)): a linear's output, or its GELU
+extern "C" __global__ void ikv_bias(const float* __restrict__ acc, const __nv_bfloat16* __restrict__ bias,
+                                    __nv_bfloat16* __restrict__ out, long long n, int cols, int act) {
+    for (long long i = blockIdx.x * (long long)blockDim.x + threadIdx.x; i < n; i += (long long)gridDim.x * blockDim.x) {
+        float v = rbf(acc[i] + (bias ? bf(bias[i % cols]) : 0.f));
+        if (act) v = gelu(v);
+        out[i] = tobf(v);
+    }
+}
+
+// x = bf16(x + bf16(bf16(acc + bias) gamma)): a branch's output through its layer scale into the residual
+extern "C" __global__ void ikv_residual(const float* __restrict__ acc, const __nv_bfloat16* __restrict__ bias,
+                                        const __nv_bfloat16* __restrict__ gamma, __nv_bfloat16* __restrict__ x,
+                                        long long n, int cols) {
+    for (long long i = blockIdx.x * (long long)blockDim.x + threadIdx.x; i < n; i += (long long)gridDim.x * blockDim.x) {
+        const int c = (int)(i % cols);
+        const float y = rbf(acc[i] + bf(bias[c]));
+        x[i] = tobf(bf(x[i]) + rbf(y * bf(gamma[c])));
+    }
+}
+
+// Rows r0 + j of q | k | v (acc [rows, 3 H 64] fp32, bias [3 H 64]) as bf16 into qkv [N, 3 H 64] (vit.Attention's
+// layout), q and k rotated by their 2D positions (pos [N, 2]: row then column; pair p < 16 turns by the column, the
+// rest by the row, at inv_freq[p % 16]); a warp a (row, head), a lane a pair
+extern "C" __global__ void ikv_qkv(const float* __restrict__ acc, const __nv_bfloat16* __restrict__ bias,
+                                   const int* __restrict__ pos, const float* __restrict__ inv_freq,
+                                   __nv_bfloat16* __restrict__ qkv, int r0, int rows, int H) {
+    const long long item = blockIdx.x * (long long)(blockDim.x >> 5) + (threadIdx.x >> 5);
+    if (item >= (long long)rows * H) return;
+    const int lane = threadIdx.x & 31;
+    const int j = (int)(item / H), h = (int)(item % H);
+    const int n = r0 + j;
+    const int width = H * 64;
+    const float* row = acc + (long long)j * 3 * width;
+    __nv_bfloat16* dst = qkv + (long long)n * 3 * width;
+    const int p = pos[2 * n + (lane < 16 ? 1 : 0)];
+    const float ang = (float)p * inv_freq[lane & 15];
+    const float c = cosf(ang), s = sinf(ang);
+    const int e = h * 64 + 2 * lane;
+    for (int which = 0; which < 2; ++which) {
+        const int at = which * width + e;
+        const float a = rbf(row[at] + bf(bias[at])), b = rbf(row[at + 1] + bf(bias[at + 1]));
+        dst[at] = tobf(fmaf(a, c, -b * s));
+        dst[at + 1] = tobf(fmaf(b, c, a * s));
+    }
+    const int at = 2 * width + e;
+    dst[at] = tobf(row[at] + bf(bias[at]));
+    dst[at + 1] = tobf(row[at + 1] + bf(bias[at + 1]));
+}
+
+// Each token's 2 x 2 patches side by side (out [rows cols, 4 width]): token (ty, tx) takes rows 1 + (2 ty + my) W +
+// 2 tx + mx of x (row 0 is the class row), (my, mx) in (0,0), (0,1), (1,0), (1,1) order; a block a token
+extern "C" __global__ void ikv_merge(const __nv_bfloat16* __restrict__ x, __nv_bfloat16* __restrict__ out, int cols,
+                                     int width) {
+    const int t = blockIdx.x, ty = t / cols, tx = t % cols, W = 2 * cols;
+    for (int c = threadIdx.x; c < 4 * width; c += blockDim.x) {
+        const int q = c / width, my = q >> 1, mx = q & 1;
+        out[(long long)t * 4 * width + c] = x[(long long)(1 + (2 * ty + my) * W + 2 * tx + mx) * width + c % width];
+    }
+}
+
+// Prompt rows take image rows: row r takes feature row map[r] (map[r] < 0: kept), a block a row
+extern "C" __global__ void ikv_inject(const __nv_bfloat16* __restrict__ feats, __nv_bfloat16* __restrict__ out,
+                                      const int* __restrict__ map, int d) {
+    const int r = blockIdx.x;
+    if (map[r] < 0) return;
+    const __nv_bfloat16* src = feats + (long long)map[r] * d;
+    for (int c = threadIdx.x; c < d; c += blockDim.x) out[(long long)r * d + c] = src[c];
+}
