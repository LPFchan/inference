+/// Pure chunk planner shared by `Images.planChunk` and unit tests.
+pub fn planChunkWith(v: ?*const Images, lane: usize, imgs: []const lanes.stream.Image, from: usize, end: usize, token_cap: usize, span_cap: usize) ChunkPlan {
+    var first: usize = 0;
+    while (first < imgs.len and @as(usize, imgs[first].at) + imgs[first].tokens <= from) : (first += 1) {}
+    var stop: usize = first;
+    var out_end = end;
+    var tok_sum: usize = 0;
+    const cap_spans = if (span_cap > 0) span_cap else 1;
+    while (stop < imgs.len) : (stop += 1) {
+        const img = imgs[stop];
+        if (img.at >= out_end) break;
+        const img_end = @as(usize, img.at) + img.tokens;
+        const in_batch = stop - first;
+        if (in_batch > 0 and (tok_sum + img.tokens > token_cap or in_batch >= cap_spans)) {
+            out_end = img.at;
+            break;
+        }
+        if (img_end > out_end and img.at > from) {
+            out_end = img.at;
+            break;
+        }
+        if (in_batch > 0 and imgs[first].at < from) {
+            if (v) |im| if (im.holds(lane, imgs[first..stop]) and !im.holds(lane, imgs[first .. stop + 1])) {
+                out_end = img.at;
+                break;
+            };
+        }
+        tok_sum += img.tokens;
+    }
+    return .{ .end = out_end, .batch = imgs[first..stop] };
+}
