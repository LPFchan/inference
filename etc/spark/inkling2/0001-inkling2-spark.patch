-        } else try f.d.check(f.d.api.cuMemcpyDtoDAsync_v2(output, input, bytes, f.stream.handle), "inkling local gather");
+            if (e.group) |g| return g.allGather(stream, input, output, bytes);
+            try e.lib.check(e.lib.api.ncclAllGather(input, output, bytes, .u8, e.comm, stream.handle), "inkling all-gather");
+        } else try f.d.check(f.d.api.cuMemcpyDtoDAsync_v2(output, input, bytes, stream.handle), "inkling local gather");
+    }
