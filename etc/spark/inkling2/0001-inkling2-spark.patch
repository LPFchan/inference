+// A fused projection's rows [rows, total] back into its pieces' own row-major buffers (widths multiples of 8).
+extern "C" __global__ void tf_ik_split(const bf16* src, int rows, int total, bf16* d0, int w0, bf16* d1, int w1,
+                                       bf16* d2, int w2, bf16* d3, int w3, bf16* d4, int w4) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x, chunks = total / 8;
+    if (i >= rows * chunks) return;
+    const int row = i / chunks;
+    int c = (i % chunks) * 8;
+    const uint4 v = *reinterpret_cast<const uint4*>(src + (size_t)row * total + c);
+    bf16* d = d0;
+    int w = w0;
+    if (c >= w0) { c -= w0; d = d1; w = w1;
+        if (c >= w1) { c -= w1; d = d2; w = w2;
+            if (c >= w2) { c -= w2; d = d3; w = w3;
+                if (c >= w3) { c -= w3; d = d4; w = w4; } } } }
+    *reinterpret_cast<uint4*>(d + (size_t)row * w + c) = v;
+}
