From ba9c87428a457f48d95a949e4a360b9ccb36d1b8 Mon Sep 17 00:00:00 2001
From: LPFchan <me@lost.plus>
Date: Wed, 18 Nov 2026 05:35:06 +0900
Subject: [PATCH 17/17] server: TENSORFOLD_GREEDY_FALLBACK=1 decodes a sampling
 request greedily on a greedy-only engine instead of refusing it

---
 zig/src/server/serve.zig  | 1 +
 zig/src/server/server.zig | 4 ++++
 2 files changed, 5 insertions(+)

diff --git a/zig/src/server/serve.zig b/zig/src/server/serve.zig
index d5b02cfc..a4601b7e 100644
--- a/zig/src/server/serve.zig
+++ b/zig/src/server/serve.zig
@@ -190,6 +190,7 @@ pub fn run(gpa: Allocator, io: std.Io, args: cli.Args, s: Setup) u8 {
         .default_voice = args.default_voice,
         .model_ids = ids.items,
         .keys_model = keys_model,
+        .greedy_fallback = std.mem.eql(u8, std.mem.trim(u8, env(s, "TENSORFOLD_GREEDY_FALLBACK") orelse "", " \t\r\n"), "1"),
         .background_ids = backgrounds,
         .default_max_tokens = args.max_tokens,
         .enable_thinking = args.thinking,
diff --git a/zig/src/server/server.zig b/zig/src/server/server.zig
index 872b9c1b..2dc2cf17 100644
--- a/zig/src/server/server.zig
+++ b/zig/src/server/server.zig
@@ -52,6 +52,9 @@ pub const Config = struct {
     /// TENSORFOLD_KEYS_MODEL: the model id whose requests take the engine's per-request edit (listed in model_ids);
     /// empty: none.
     keys_model: []const u8 = "",
+    /// TENSORFOLD_GREEDY_FALLBACK=1: on a greedy-only engine, a request that asks to sample decodes greedily instead of
+    /// being refused (for clients that always send a temperature).
+    greedy_fallback: bool = false,
     /// Ids a request may name for background priority by default (--name-priority); each is in model_ids.
     background_ids: []const []const u8 = &.{},
     default_max_tokens: i64 = 4096,
@@ -306,6 +309,7 @@ pub const Server = struct {
         try merge(options, cx, supplied);
         const temp = number(options.get("temperature")) orelse 0;
         if (temp <= 0) return null;
+        if (srv.info.capability(.greedy_only) and srv.config.greedy_fallback) return null;
         if (srv.info.capability(.greedy_only)) return cx.refuse(if ((if (defaults) |d| number(d.get("temperature")) else null) orelse 0 > 0)
             "this engine decodes greedily only and this server samples by default: send temperature 0, or serve with --temperature 0"
         else
