diff --git a/zig/kernels/cuda/inkling2_rows.cuh b/zig/kernels/cuda/inkling2_rows.cuh
index e3f6b393..d9d83c3d 100644
--- a/zig/kernels/cuda/inkling2_rows.cuh
+++ b/zig/kernels/cuda/inkling2_rows.cuh
@@ -82,3 +82,56 @@ extern "C" __global__ void tf_ik_top1(const float* x, InklingPick* out, int coun
     }
     if (!t) *out = {values[0], (unsigned)(ids[0] + first), (unsigned)bad[0], 0};
 }
+
+// tf_ik_top1 plus the softmax mass beside the maximum: pad carries sum(exp(x - max)) as float bits, so the host
+// turns the ranks' picks into the winner's probability. One 1024-thread block, float4 loads, online logsumexp.
+struct IkTop {
+    float value, mass;
+    int id, bad;
+};
+__device__ __forceinline__ void ik_top_add(IkTop& t, float v, int i) {
+    if (!isfinite(v)) { t.bad = 1; return; }
+    if (v > t.value) { t.mass = t.mass * __expf(t.value - v) + 1.f; t.value = v; t.id = i; }
+    else { t.mass += __expf(v - t.value); if (v == t.value && i < t.id) t.id = i; }
+}
+__device__ __forceinline__ IkTop ik_top_join(IkTop a, IkTop b) {
+    const float top = fmaxf(a.value, b.value);
+    IkTop r;
+    r.mass = (a.value == -INFINITY ? 0.f : a.mass * __expf(a.value - top)) + (b.value == -INFINITY ? 0.f : b.mass * __expf(b.value - top));
+    const bool take = b.value > a.value || (b.value == a.value && b.id < a.id);
+    r.value = take ? b.value : a.value;
+    r.id = take ? b.id : a.id;
+    r.bad = a.bad | b.bad;
+    return r;
+}
+__device__ __forceinline__ IkTop ik_top_shuffle(IkTop t, int o) {
+    IkTop u;
+    u.value = __shfl_xor_sync(0xffffffffu, t.value, o);
+    u.mass = __shfl_xor_sync(0xffffffffu, t.mass, o);
+    u.id = __shfl_xor_sync(0xffffffffu, t.id, o);
+    u.bad = __shfl_xor_sync(0xffffffffu, t.bad, o);
+    return ik_top_join(t, u);
+}
+extern "C" __global__ void __launch_bounds__(1024) tf_ik_top1p(const float* x, InklingPick* out, int count, int first) {
+    __shared__ IkTop part[32];
+    const int t = threadIdx.x;
+    IkTop top = {-INFINITY, 0.f, 0x7fffffff, 0};
+    const int quads = count / 4;
+    const float4* x4 = reinterpret_cast<const float4*>(x);
+    for (int q = t; q < quads; q += 1024) {
+        const float4 v = x4[q];
+        ik_top_add(top, v.x, 4 * q);
+        ik_top_add(top, v.y, 4 * q + 1);
+        ik_top_add(top, v.z, 4 * q + 2);
+        ik_top_add(top, v.w, 4 * q + 3);
+    }
+    for (int i = 4 * quads + t; i < count; i += 1024) ik_top_add(top, x[i], i);
+    for (int o = 16; o; o >>= 1) top = ik_top_shuffle(top, o);
+    if ((t & 31) == 0) part[t >> 5] = top;
+    __syncthreads();
+    if (t < 32) {
+        top = part[t];
+        for (int o = 16; o; o >>= 1) top = ik_top_shuffle(top, o);
+        if (!t) *out = {top.value, (unsigned)(top.id + first), (unsigned)top.bad, __float_as_uint(top.mass)};
+    }
+}
