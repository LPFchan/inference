     const int t = threadIdx.x, w = t >> 5, lane = t & 31, g = lane >> 2, sub = lane & 3;
     const int r0 = blockIdx.x * BR, head = blockIdx.y, kh = head / (a.hq / a.hk);
     const int last = a.pos + min(a.rows, r0 + BR) - 1;
@@ -71,7 +83,10 @@ extern "C" __global__ __launch_bounds__(128) void tf_ik_attention_flash(InklingA
     const int rows_abs[2] = {a.pos + wr + g, a.pos + wr + g + 8};
     const bool rows_ok[2] = {wr + g < a.rows, wr + g + 8 < a.rows};
     const int start = first / BK * BK;
+    // a tile needs the bias when some row of the block is under 1024 past its first key
+    auto near = [&](int b) { return a.pos + r0 + BR - 1 - b < 1024 + BK - 1 + BR; };
     stage(ks, a.k, start, last, a.capacity, a.hk, kh);
+    if (near(start)) stage_rel(rs, a.relative, r0, a.pos, a.rows, a.hq, head, start);
     commit();
     stage(vs, a.v, start, last, a.capacity, a.hk, kh);
     commit();
@@ -88,13 +103,21 @@ extern "C" __global__ __launch_bounds__(128) void tf_ik_attention_flash(InklingA
         }
         // scale, relative bias, mask; the tile's row maxima
         float tm[2] = {-INFINITY, -INFINITY};
-        for (int n = 0; n < 8; ++n) for (int e = 0; e < 4; ++e) {
-            const int h = e >> 1, key = base + n * 8 + 2 * sub + (e & 1), distance = rows_abs[h] - key;
-            const bool valid = rows_ok[h] && distance >= 0 && key >= 0 && (!a.window || distance <= a.window);
-            float score = s[n][e] * 0.08838834764831845f;
-            if (valid && distance < 1024) score += f(a.relative[((size_t)(wr + g + 8 * h) * a.hq + head) * 1024 + distance]);
-            s[n][e] = valid ? score : -INFINITY;
-            tm[h] = fmaxf(tm[h], s[n][e]);
+        // a warp whose 16 rows are all real and at least 1024 past the tile's last key: every score is valid, no bias
+        if (!a.window && wr + 16 <= a.rows && a.pos + wr - (base + BK - 1) >= 1024) {
+            for (int n = 0; n < 8; ++n) for (int e = 0; e < 4; ++e) {
+                s[n][e] = s[n][e] * 0.08838834764831845f;
+                tm[e >> 1] = fmaxf(tm[e >> 1], s[n][e]);
+            }
+        } else {
+            for (int n = 0; n < 8; ++n) for (int e = 0; e < 4; ++e) {
+                const int h = e >> 1, key = base + n * 8 + 2 * sub + (e & 1), distance = rows_abs[h] - key;
+                const bool valid = rows_ok[h] && distance >= 0 && key >= 0 && (!a.window || distance <= a.window);
+                float score = s[n][e] * 0.08838834764831845f;
+                if (valid && distance < 1024) score += f(rs[w * 16 + g + 8 * h][distance - rel_first(rows_abs[h], base)]);
+                s[n][e] = valid ? score : -INFINITY;
+                tm[h] = fmaxf(tm[h], s[n][e]);
+            }
         }
         float alpha[2];
         for (int h = 0; h < 2; ++h) {
@@ -124,6 +147,7 @@ extern "C" __global__ __launch_bounds__(128) void tf_ik_attention_flash(InklingA
         __syncthreads(); // every warp is past its K reads and V has landed
         if (base + BK <= last) {
             stage(ks, a.k, base + BK, last, a.capacity, a.hk, kh);
+            if (near(base + BK)) stage_rel(rs, a.relative, r0, a.pos, a.rows, a.hq, head, base + BK);
         }
         commit();
