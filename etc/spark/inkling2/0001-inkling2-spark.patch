diff --git a/zig/kernels/cuda/inkling2_exl3.cuh b/zig/kernels/cuda/inkling2_exl3.cuh
index bdf6a14b..3027b1ec 100644
--- a/zig/kernels/cuda/inkling2_exl3.cuh
+++ b/zig/kernels/cuda/inkling2_exl3.cuh
@@ -63,6 +63,47 @@ extern "C" __global__ void tf_ik_down_input(const bf16* gu, const float* gamma,
     }
 }
 
+// The up projection's input of one row: tf_ik_quant, then tf_ik_rotate for each of its `slots` picks, in one CTA, their
+// arithmetic in their order, the rounded row kept in shared memory. blockDim: quantThreads(width); width a multiple of
+// 128, at most 4608.
+extern "C" __global__ void tf_ik_up_input(const bf16* x, const int* picks, const half* suh, half* out, int width,
+                                         int slots, int nvfp4, int experts) {
+    const int row = blockIdx.x, t = threadIdx.x, lane = t & 31;
+    __shared__ __align__(16) half xs[4608];
+    if ((int)blockDim.x < width / 16 || blockDim.x % 32 || width > 4608) __trap();
+    const bool on = t < width / 16;
+    float values[16];
+    if (on) {
+        const uint4* p = reinterpret_cast<const uint4*>(x + (size_t)row * width + t * 16);
+        const uint4 u0 = p[0], u1 = p[1];
+        const bf16* h0 = reinterpret_cast<const bf16*>(&u0);
+        const bf16* h1 = reinterpret_cast<const bf16*>(&u1);
+#pragma unroll
+        for (int j = 0; j < 8; ++j) values[j] = f(h0[j]), values[8 + j] = f(h1[j]);
+    } else {
+#pragma unroll
+        for (int j = 0; j < 16; ++j) values[j] = 0.f;
+    }
+    ik_round(values, on, nvfp4, xs + t * 16);
+    __syncthreads();
+    const int blocks = width / 128;
+    for (int u = t >> 5; u < slots * blocks; u += blockDim.x >> 5) {
+        const int pair = row * slots + u / blocks, c = u % blocks * 128 + lane * 4;
+        const int expert = picks[pair];
+        if (expert < 0 || expert >= experts) continue;
+        const uint2 xr = *reinterpret_cast<const uint2*>(xs + c);
+        const uint2 sr = *reinterpret_cast<const uint2*>(suh + (size_t)expert * width + c);
+        const half* xh = reinterpret_cast<const half*>(&xr);
+        const half* sh = reinterpret_cast<const half*>(&sr);
+        float v[4];
+        for (int j = 0; j < 4; ++j) v[j] = __half2float(__hmul(xh[j], sh[j]));
+        tf_exl3::fwht128(v, lane);
+        half o[4];
+        for (int j = 0; j < 4; ++j) o[j] = __float2half_rn(v[j] * tf_exl3::HAD_SCALE);
+        *reinterpret_cast<uint2*>(out + (size_t)pair * width + c) = *reinterpret_cast<const uint2*>(o);
+    }
+}
