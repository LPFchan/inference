+//! The refusal edit at run time: y -= s E (Eᵀ y) on each layer's summed attention and MoE outputs, which equals editing
+//! wo and every expert's w2 as W' = W - s E Eᵀ W. TF_INKLING_EDIT names tools/export_edit.py's directory: edit.json
+//! {"hidden", "rank", "s_attn", "s_mlp"} and q.f32 (E [hidden][rank] fp32, orthonormal columns, rank at most 4).
+//! Loaded, it runs only for requests that ask (the server's TENSORFOLD_KEYS_MODEL), from their own captured graphs.
+const std = @import("std");
+const cuda = @import("cuda");
+const cfg = @import("config.zig");
+
+const Meta = struct { hidden: usize, rank: usize, s_attn: []const f32, s_mlp: []const f32 };
+
+pub const Edit = struct {
+    buf: cuda.DeviceBuffer, // E
+    rank: u32,
+    s: [cfg.layers][2]f32, // per layer: the attention output's strength, the MoE output's (0: that site unedited)
+
+    pub fn e(x: *const Edit) u64 {
+        return x.buf.ptr;
+    }
+    pub fn deinit(x: *Edit) void {
+        x.buf.free();
+    }
+
+    pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, path: []const u8) !Edit {
+        var dir = try std.Io.Dir.cwd().openDir(io, path, .{});
+        defer dir.close(io);
+        const text = try dir.readFileAlloc(io, "edit.json", gpa, .limited(1 << 20));
+        defer gpa.free(text);
+        var doc = try std.json.parseFromSlice(Meta, gpa, text, .{ .ignore_unknown_fields = true });
+        defer doc.deinit();
+        const m = doc.value;
+        if (m.hidden != cfg.hidden or m.rank == 0 or m.rank > 4 or m.s_attn.len != cfg.layers or m.s_mlp.len != cfg.layers) {
+            std.log.err("TF_INKLING_EDIT: the edit is for hidden {d}, rank {d}, {d} layers", .{ m.hidden, m.rank, m.s_attn.len });
+            return error.InklingEdit;
+        }
+        const q = try dir.readFileAlloc(io, "q.f32", gpa, .limited(1 << 26));
+        defer gpa.free(q);
+        if (q.len != m.hidden * m.rank * 4) return error.InklingEdit;
+        var x: Edit = .{ .buf = try cuda.DeviceBuffer.alloc(d, q.len), .rank = @intCast(m.rank), .s = undefined };
+        errdefer x.buf.free();
+        try x.buf.upload(0, q);
+        for (&x.s, m.s_attn, m.s_mlp) |*s, a, b| s.* = .{ a, b };
+        return x;
+    }
+};
