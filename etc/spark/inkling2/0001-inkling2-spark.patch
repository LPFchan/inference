--- a/zig/kernels/cuda/inkling2_attention_flash.cuh
+++ b/zig/kernels/cuda/inkling2_attention_flash.cuh
@@ -1,6 +1,7 @@
 // Prompt-pass attention, flash style: 64 query rows of one head a block (16 a warp), 64-key tiles of BF16 keys and
 // values staged by cp.async, Q.K and P.V on tensor cores with P in BF16, the softmax online in registers. The same
-// relative bias, window, gate and sink as the decode kernels. Keys past the last row read as zeros.
+// relative bias, window, gate and sink as the decode kernels; a tile's bias rows are staged with its keys, and tiles
+// 1024 or more behind a warp's rows skip the per-score mask. Keys past the last row read as zeros.
 #pragma once
 #include "inkling2_common.cuh"
 using namespace inkling2;
@@ -43,12 +44,23 @@ __device__ inline void stage(bf16 (*dst)[LD], const bf16* cache, int base, int l
         cp16(&dst[row][piece * 8], src, valid);
     }
 }
+// The relative bias a 64-key tile needs: block row i (absolute a.pos + r0 + i) takes distances from the 8-aligned
+// floor of its smallest, 72 of them (nine 16-byte pieces), whole pieces inside [0, 1024) and real rows only.
+constexpr int RB = 72;
+__device__ inline int rel_first(int row_abs, int base) { return (row_abs - base - (BK - 1)) >> 3 << 3; }
+__device__ inline void stage_rel(bf16 (*dst)[RB], const bf16* relative, int r0, int pos, int rows, int hq, int head, int base) {
+    for (int i = threadIdx.x; i < BR * (RB / 8); i += 128) {
+        const int row = i / (RB / 8), piece = i % (RB / 8), first = rel_first(pos + r0 + row, base) + piece * 8;
+        const bool valid = r0 + row < rows && first >= 0 && first < 1024;
+        cp16(&dst[row][piece * 8], relative + ((size_t)(valid ? r0 + row : 0) * hq + head) * 1024 + (valid ? first : 0), valid);
+    }
+}
 } // namespace ik_flash
 
 extern "C" __global__ __launch_bounds__(128) void tf_ik_attention_flash(InklingAttention a) {
     using namespace ik_flash;
