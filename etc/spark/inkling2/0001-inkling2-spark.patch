+    try std.testing.expectEqual(Piece{ .src = 256 * 64, .dst = 512 * 288 + 512 * 64, .len = 6400 }, p[1]);
+    try std.testing.expectEqual(Piece{ .src = 4 * 256 * 64 + 2 * 256 * 8, .dst = 512 * 288 + 4 * 512 * 64 + 2 * 512 * 8, .len = 800 }, p[6]);
+    try std.testing.expectEqual(@as(usize, 1), pieces(mv, 4 * 256, 4, false, &buf).len);
+}
