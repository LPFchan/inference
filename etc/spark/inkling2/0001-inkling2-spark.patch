index d1604c0d..6959f558 100644
--- a/zig/kernels/cuda/inkling2_draft.cu
+++ b/zig/kernels/cuda/inkling2_draft.cu
@@ -103,9 +103,12 @@ extern "C" __global__ void tf_ik_draft_store(const bf16* x, bf16* cache, int wid
     if (i < rows * width) cache[(size_t)((pos + i / width) % capacity) * width + i % width] = x[i];
 }
 
-// One warp owns a query and a head; fixed key partitions keep global history work distributed.
+// One warp owns a query and a head; fixed key partitions keep global history work distributed. An FP4 ring
+// (inkling2_kv4.cuh) is widened 32 keys at a time into shared rows the eight warps share; each key's arithmetic is
+// the BF16 ring's, in its order.
 extern "C" __global__ void tf_ik_draft_attention(const bf16* q, const bf16* k, const bf16* v,
                                                 float* parts, int pos, int hq, int hk, int capacity, int local, int fp4) {
+    __shared__ __align__(16) bf16 ks[32][128], vs[32][128];
     const int row = threadIdx.x / 32, lane = threadIdx.x % 32;
     const int head = blockIdx.x, split = blockIdx.y, keyhead = head / (hq / hk);
     const int first = local ? max(0, pos - 1024) : 0, end = pos + 8;
@@ -114,17 +117,35 @@ extern "C" __global__ void tf_ik_draft_attention(const bf16* q, const bf16* k, c
     float query[4], value[4] = {0.f, 0.f, 0.f, 0.f};
     for (int d = 0; d < 4; ++d) query[d] = f(q[((size_t)row * hq + head) * 128 + lane + d * 32]);
     float maximum = -INFINITY, denominator = 0.f;
-    for (int key = low; key < high; ++key) {
-        const size_t base = ((size_t)(key % capacity) * hk + keyhead) * 128 + lane;
-        const unsigned char *k4 = reinterpret_cast<const unsigned char*>(k), *v4 = reinterpret_cast<const unsigned char*>(v);
+    auto step = [&](const bf16* kr, const bf16* vr) { // one key's 128 values, this lane's at lane + 32 d
         float dot = 0.f;
-        for (int d = 0; d < 4; ++d) dot += query[d] * (fp4 ? ik_kv4::get(k4, capacity, hk, keyhead, key % capacity, lane + d * 32) : f(k[base + d * 32]));
+        for (int d = 0; d < 4; ++d) dot += query[d] * f(kr[d * 32]);
         for (int delta = 16; delta; delta >>= 1) dot += __shfl_xor_sync(0xffffffffu, dot, delta);
         dot *= 0.08838834764831845f;
         const float next = fmaxf(maximum, dot), scale = expf(maximum - next), p = expf(dot - next);
         denominator = denominator * scale + p;
-        for (int d = 0; d < 4; ++d) value[d] = value[d] * scale + p * (fp4 ? ik_kv4::get(v4, capacity, hk, keyhead, key % capacity, lane + d * 32) : f(v[base + d * 32]));
+        for (int d = 0; d < 4; ++d) value[d] = value[d] * scale + p * f(vr[d * 32]);
         maximum = next;
+    };
+    if (fp4) {
+        const unsigned char *k4 = reinterpret_cast<const unsigned char*>(k), *v4 = reinterpret_cast<const unsigned char*>(v);
+        for (int t0 = low; t0 < high; t0 += 32) {
+            const int n = min(32, high - t0);
+            __syncthreads(); // every warp is done with the last tile
+            for (int i = threadIdx.x; i < n * 16; i += blockDim.x) {
+                const int key = i / 16, word = i % 16, slot = (t0 + key) % capacity;
+                unsigned w, s8;
+                ik_kv4::load(k4, capacity, hk, keyhead, slot, word, w, s8);
+                *reinterpret_cast<uint4*>(&ks[key][word * 8]) = ik_kv4::unpack8(w, s8);
+                ik_kv4::load(v4, capacity, hk, keyhead, slot, word, w, s8);
+                *reinterpret_cast<uint4*>(&vs[key][word * 8]) = ik_kv4::unpack8(w, s8);
+            }
+            __syncthreads();
+            for (int j = 0; j < n; ++j) step(&ks[j][lane], &vs[j][lane]);
+        }
+    } else for (int key = low; key < high; ++key) {
+        const size_t base = ((size_t)(key % capacity) * hk + keyhead) * 128 + lane;
+        step(k + base, v + base);
     }
