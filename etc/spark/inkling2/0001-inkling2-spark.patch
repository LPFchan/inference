index 5052a301..be1fa921 100644
--- a/zig/kernels/cuda/inkling2_residual.cuh
+++ b/zig/kernels/cuda/inkling2_residual.cuh
@@ -143,6 +143,36 @@ extern "C" __global__ void tf_ik_rank_sum(const float* parts, bf16* out, int cou
     out[i] = b(v);
 }
 
+// The refusal edit y -= s·E(Eᵀy) on each row of y, in place (one 512-thread block a row, width at most 4608):
+// E fp32 [width][ek] orthonormal columns, ek at most 4. Launched only for requests that take the edit.
+extern "C" __global__ void __launch_bounds__(512) tf_ik_edit(bf16* y, int width, const float* E, int ek, float s) {
+    __shared__ float part[16][4];
+    bf16* row = y + (size_t)blockIdx.x * width;
+    float v[9], c[4] = {0.f, 0.f, 0.f, 0.f};
+    for (int k = 0; k < 9; ++k) {
+        const int i = threadIdx.x + k * 512;
+        v[k] = i < width ? f(row[i]) : 0.f;
+        if (i < width) for (int j = 0; j < ek; ++j) c[j] += E[(size_t)i * ek + j] * v[k];
+    }
+    for (int j = 0; j < ek; ++j) {
+        for (int o = 16; o; o >>= 1) c[j] += __shfl_xor_sync(0xffffffffu, c[j], o);
+        if ((threadIdx.x & 31) == 0) part[threadIdx.x >> 5][j] = c[j];
+    }
+    __syncthreads();
+    for (int j = 0; j < ek; ++j) {
+        float t = 0.f;
+        for (int w = 0; w < 16; ++w) t += part[w][j];
+        c[j] = t;
+    }
+    for (int k = 0; k < 9; ++k) {
+        const int i = threadIdx.x + k * 512;
+        if (i >= width) continue;
+        float p = 0.f;
+        for (int j = 0; j < ek; ++j) p += E[(size_t)i * ek + j] * c[j];
+        row[i] = b(v[k] - s * p);
+    }
+}
+
 extern "C" __global__ void tf_ik_logits(float* out, int n) {
     const int i = blockIdx.x * blockDim.x + threadIdx.x;
     if (i < n) out[i] = 30.f * tanhf(out[i] / 30.f);
