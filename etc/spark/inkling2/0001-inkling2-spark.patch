 4 files changed, 241 insertions(+), 33 deletions(-)

diff --git a/zig/kernels/cuda/inkling2_residual.cuh b/zig/kernels/cuda/inkling2_residual.cuh
index be1fa921..fbe768b1 100644
--- a/zig/kernels/cuda/inkling2_residual.cuh
+++ b/zig/kernels/cuda/inkling2_residual.cuh
@@ -143,6 +143,16 @@ extern "C" __global__ void tf_ik_rank_sum(const float* parts, bf16* out, int cou
     out[i] = b(v);
 }
 
+// tf_ik_rank_sum for two ranks over one rank's share of the rows: rank 0's partial p0 and rank 1's p1, in rank order.
+extern "C" __global__ void tf_ik_pair_sum(const float* p0, const float* p1, bf16* out, int count) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= count) return;
+    float v = 0.f;
+    v += p0[i];
+    v += p1[i];
+    out[i] = b(v);
+}
+
 // The refusal edit y -= s·E(Eᵀy) on each row of y, in place (one 512-thread block a row, width at most 4608):
 // E fp32 [width][ek] orthonormal columns, ek at most 4. Launched only for requests that take the edit.
 extern "C" __global__ void __launch_bounds__(512) tf_ik_edit(bf16* y, int width, const float* E, int ek, float s) {
