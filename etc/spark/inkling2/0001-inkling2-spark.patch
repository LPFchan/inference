@@ -302,22 +317,27 @@ __global__ void __launch_bounds__(WM * WN * 32, 1) prompt_lean(
         ++issued;
         if (++lg == KG) {
             lg = 0;
-            lt += gridDim.x;
+            lt = claimed[++ln & 3];
             if (lt < tiles) plan(lt);
         }
     };
 
-    if (blockIdx.x >= tiles) return;
-    if (tid == 0)
