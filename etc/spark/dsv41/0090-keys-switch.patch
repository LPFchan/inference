         out[i] = ty == 1 ? rows[(long long)row_of[t] * dim + c] : ty == 0 ? start[c] : ty == 2 ? newline[c] : end[c];
     }
 }
+
+// TF_DS_KEYS (keys.zig): a rank-1 projection on a row of wo_b's fp32 output, y -= lambda * dir * (dir . y), for each row
+// whose mask entry is nonzero (mask null: every row). One block a row; the dot is summed in a fixed order (each thread's
+// strided partial, then a shared-memory tree), so a row's result does not depend on the other rows of the launch.
+extern "C" __global__ void __launch_bounds__(256) tf_ds_keys_kernel(float* y, unsigned long long ldy, const float* dir,
+                                                                   const long long* mask, int hidden, float lambda) {
+    const int row = blockIdx.x;
+    if (mask != nullptr && mask[row] == 0) return;
+    float* yr = y + (unsigned long long)row * ldy;
+    __shared__ float part[256];
+    float s = 0.f;
+    for (int c = threadIdx.x; c < hidden; c += blockDim.x) s += dir[c] * yr[c];
+    part[threadIdx.x] = s;
+    __syncthreads();
+    for (int w = blockDim.x / 2; w > 0; w >>= 1) {
+        if (threadIdx.x < w) part[threadIdx.x] += part[threadIdx.x + w];
+        __syncthreads();
+    }
+    const float k = lambda * part[0];
+    for (int c = threadIdx.x; c < hidden; c += blockDim.x) yr[c] -= k * dir[c];
+}
