diff --git a/zig/src/families/dsv41/keys.zig b/zig/src/families/dsv41/keys.zig
new file mode 100644
index 0000000..b082729
--- /dev/null
+++ b/zig/src/families/dsv41/keys.zig
@@ -0,0 +1,76 @@
+//! TF_DS_KEYS: an abliteration chosen per request on the stock weights. drowzeys' Keys overlay for
+//! DeepSeek-V4.1-Flash-1017 is the rank-1 edit wo_b' = (I - lambda d d^T) wo_b on layers 10-35 (one unit direction d of
+//! the hidden size, lambda 3.5). Applied to wo_b's fp32 output instead, y -= lambda * d * (d . y), it is the same model
+//! for the rows of a stream that asked for it and leaves every other row as stock. The correction is linear, so each TP
+//! rank applies it to its own partial before the ranks' sum.
+//!
+//!   TF_DS_KEYS_DIR=path      a safetensors file with `direction` (f32 [hidden]); unset: off, the engine as before
+//!   TF_DS_KEYS_LAMBDA=3.5    the edit's strength
+//!   TF_DS_KEYS_LAYERS=10-35  the layers it applies to, both ends included
+//!
+//! Every rank needs the same three settings. Rank 0 sends each stream's flag in its fill_begin frame; a follower without
+//! TF_DS_KEYS_DIR refuses a set flag (error.KeysOff) rather than edit half the sum.
+const std = @import("std");
+const max_streams = @import("draft.zig").max_streams;
+
+pub const Keys = struct {
+    dir: u64, // f32 [hidden] on the device
+    lambda: f32,
+    lo: usize,
+    hi: usize,
+    slot_on: [max_streams]bool = @splat(false), // each slot's stream asked for it (set at its fill_begin)
+    fill_on: bool = false, // the filling stream's (Model.fillBegin)
+
+    pub fn covers(k: *const Keys, li: usize) bool {
+        return li >= k.lo and li <= k.hi;
+    }
+};
+
+pub const Settings = struct { path: []const u8, lambda: f32, lo: usize, hi: usize };
+
+/// The settings from the environment; null when TF_DS_KEYS_DIR is unset or empty.
+pub fn settings(layers: usize) !?Settings {
+    const path = env("TF_DS_KEYS_DIR") orelse return null;
+    if (path.len == 0) return null;
+    const lambda = if (env("TF_DS_KEYS_LAMBDA")) |v| try std.fmt.parseFloat(f32, std.mem.trim(u8, v, " ")) else 3.5;
+    if (!(lambda > 0 and lambda < 100)) return error.BadKeysLambda;
+    var lo: usize = 10;
+    var hi: usize = 35;
+    if (env("TF_DS_KEYS_LAYERS")) |v| {
+        const r = try parseRange(v);
+        lo = r[0];
+        hi = r[1];
+    }
+    if (hi >= layers) return error.BadKeysLayers;
+    return .{ .path = path, .lambda = lambda, .lo = lo, .hi = hi };
+}
+
+/// "lo-hi" (both included), lo <= hi.
+pub fn parseRange(text: []const u8) ![2]usize {
+    const t = std.mem.trim(u8, text, " ");
+    const dash = std.mem.indexOfScalar(u8, t, '-') orelse return error.BadKeysLayers;
+    const lo = std.fmt.parseInt(usize, t[0..dash], 10) catch return error.BadKeysLayers;
+    const hi = std.fmt.parseInt(usize, t[dash + 1 ..], 10) catch return error.BadKeysLayers;
+    if (lo > hi) return error.BadKeysLayers;
+    return .{ lo, hi };
+}
+
+fn env(name: [:0]const u8) ?[]const u8 {
+    return std.mem.span(std.c.getenv(name) orelse return null);
+}
+
+test "layer ranges" {
+    try std.testing.expectEqual([2]usize{ 10, 35 }, try parseRange("10-35"));
+    try std.testing.expectEqual([2]usize{ 7, 7 }, try parseRange(" 7-7 "));
+    try std.testing.expectError(error.BadKeysLayers, parseRange("35-10"));
+    try std.testing.expectError(error.BadKeysLayers, parseRange("10"));
+    try std.testing.expectError(error.BadKeysLayers, parseRange("a-3"));
+}
+
+test "covers" {
+    const k: Keys = .{ .dir = 0, .lambda = 3.5, .lo = 10, .hi = 35 };
+    try std.testing.expect(!k.covers(9));
+    try std.testing.expect(k.covers(10));
+    try std.testing.expect(k.covers(35));
+    try std.testing.expect(!k.covers(36));
+}
